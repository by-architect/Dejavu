    "dejavu_sync_signed_out": {
      "extractionState": "manual",
      "localizations": {
        "ab": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen ду шәыԥхьаӡаз аҭыԥқәа расинхронизациа азы, Mozilla аккаунт аҟны шәхы."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የስራ ቦታዎችዎን ከZen ጋር ለማመሳሰል ወደ Mozilla መለያዎ ይግቡ።"
          }
        },
        "an": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en a tuya cuenta de Mozilla ta sincronizar os tuyos espacios de treballo con Zen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول إلى حساب Mozilla لمزامنة مساحات عملك مع Zen."
          }
        },
        "ast": {
          "stringUnit": {
            "state": "translated",
            "value": "Anicia sesión na to cuenta Mozilla pa sincronizar los tos espacios de trabayu con Zen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İş sahələrinizi Zen ilə sinxronlaşdırmaq üçün Mozilla hesabınıza daxil olun."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "ایش ساحه‌لرینیزی Zen ایله همگام‌سازی ائتمک اوچون Mozilla حسابینیزا داخل اولون."
          }
        },
        "ban": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in ka akun Mozilla ragane anggon nyinkronang genah ragane ajak Zen."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Увайдзіце ва ўліковы запіс Mozilla, каб сінхранізаваць вашы прасторы з Zen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влезте в профила си в Mozilla, за да синхронизирате работните си пространства със Zen."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-এর সাথে আপনার ওয়ার্কস্পেস Sync করতে আপনার Mozilla অ্যাকাউন্টে সাইন ইন করুন।"
          }
        },
        "bqi": {
          "stringUnit": {
            "state": "translated",
            "value": "بره همگام کردن فضا یلت با Zen، بیا تو حساب Mozilla خودت."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Kevreit ouzh ho kont Mozilla evit goubredañ hoc’h egorioù labour gant Zen."
          }
        },
        "brh": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen گدا نی نا ورک سپیساک سنک کننا نا واسطے نی نا Mozilla اکاؤنٹ اٹ سائن ان کبو۔"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se na svoj Mozilla račun da sinhronizujete radne prostore sa Zenom."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicieu la sessió amb el vostre compte de Mozilla per sincronitzar els espais de treball amb el Zen."
          }
        },
        "cak": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatok pa ri Rukwenta Mozilla richin najunamirisaj ri taq asamajib'äl rik'in Zen."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in sa imong Mozilla account para i-sync ang imong mga workspace uban sa Zen."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بچۆرە ژوورەوە بۆ هەژماری Mozilla ی خۆت بۆ هاوکاتکردنی فەزاکانت لەگەڵ Zen."
          }
        },
        "co": {
          "stringUnit": {
            "state": "translated",
            "value": "Cunnettitevi à u vostru contu Mozilla per sincrunizà i vostri spazii di travagliu cù Zen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro synchronizaci pracovních prostorů se Zen se přihlaste ke svému účtu Mozilly."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mewngofnodwch i’ch cyfrif Mozilla i gydweddu’ch gweithleoedd â Zen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på din Mozilla-konto for at synkronisere dine arbejdsområder med Zen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei deinem Mozilla-Konto an, um deine Arbeitsbereiche mit Zen zu synchronisieren."
          }
        },
        "dsb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pśizjaw se ze swójim Mozilla-kontom, aby swóje źěłowe rumy z Zen synchronizěrował."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε στον λογαριασμό Mozilla σας για να συγχρονίσετε τους χώρους εργασίας σας με το Zen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to your Mozilla account to sync your workspaces with Zen."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensalutu al via Mozilla-konto por sinkronigi viajn laborspacojn kun Zen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu cuenta de Mozilla para sincronizar tus espacios de trabajo con Zen."
          }
        },
        "es-AR": {

        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkazy, ktoré otvoríte z iných aplikácií, sa spustia v tomto pracovnom priestore a kontajneri. Tlačidlo Naspäť vás vráti do aplikácie."

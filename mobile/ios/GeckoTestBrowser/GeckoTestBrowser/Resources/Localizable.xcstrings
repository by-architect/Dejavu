    "dejavu_delete_items_message": {
      "extractionState": "manual",
      "localizations": {
        "ab": {
          "stringUnit": {
            "state": "translated",
            "value": "Ификсациатә абларҭақәа, иҵакыу сайтқәа ма ипапкақәа, зегьы ишьаны, ианыхуеит, насгьы иаарту абларҭақәа арктәуп."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የተሰኩ ትሮች፣ አስፈላጊዎች እና አቃፊዎች በውስጣቸው ካለው ሁሉ ጋር ይወገዳሉ፣ ክፍት ትሮቻቸውም ይዘጋሉ።"
          }
        },
        "an": {
          "stringUnit": {
            "state": "translated",
            "value": "As pestanyas fixadas, os esenciales y as carpetas con tot o suyo contenito s'eliminan, y as suyas pestanyas ubiertas se zarran."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُزال التبويبات المثبتة والأساسيات والمجلدات وكل ما بداخلها، وتُغلق تبويباتها المفتوحة."
          }
        },
        "ast": {
          "stringUnit": {
            "state": "translated",
            "value": "Les llingüetes fixaes, los esenciales y les carpetes con too lo que tienen dientro quítense, y les sos llingüetes abiertes zárrense."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bərkidilmiş vərəqlər, əsaslar və içindəki hər şeylə birlikdə qovluqlar silinir, açıq vərəqləri bağlanır."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "برکیدیلمیش تاغلار، اساس‌لار و ایچینده‌کی هر شئی‌له بیرلیکده پوشه‌لر سیلینیر، آچیق تاغلاری باغلانیر."
          }
        },
        "ban": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab kasemat, Penting, lan map ajak saisinne makejang kaapus, tur tab ane mukak katutup."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Замацаваныя карткі, важнае і папкі з усім, што ў іх ёсць, выдаляюцца, а іх адкрытыя карткі закрываюцца."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Закачените раздели, Любимите и папките с всичко в тях се премахват, а отворените им раздели се затварят."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পিন করা ট্যাব, এসেনশিয়াল ও ফোল্ডার ভেতরের সবকিছুসহ সরিয়ে ফেলা হবে এবং সেগুলোর খোলা ট্যাব বন্ধ করা হবে।"
          }
        },
        "bqi": {
          "stringUnit": {
            "state": "translated",
            "value": "بلگه یل سنجاق‌وابیده، سایت یل مهم و پوشه یل با هر چی توشونه، پاک می‌بن، و بلگه یل گۊشیده‌شون بسته می‌بن."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Ivinelloù spilhennet, traoù pouezus ha teuliadoù, gant kement zo enno, a vez lamet, hag o ivinelloù digor a vez serret."
          }
        },
        "brh": {
          "stringUnit": {
            "state": "translated",
            "value": "پن ٹیباک، ضروری چیزاک او فولڈراک، اے نا اندرین ہر چیز سمیت ہٹ ہن، او اے نا مل ٹیباک بند ہن۔"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikvačeni tabovi, Favoriti i folderi sa svime unutar njih se uklanjaju, a njihovi otvoreni tabovi se zatvaraju."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Se suprimeixen les pestanyes fixades, els essencials i les carpetes amb tot el seu contingut, i es tanquen les seves pestanyes obertes."
          }
        },
        "cak": {
          "stringUnit": {
            "state": "translated",
            "value": "Ri ximon taq ruwi', taq rajawaxel chuqa' taq karpeta, rachib'il ronojel ri k'o chi rupam, yeyuj, chuqa' ri taq ruwi' jaqel yetz'apïx."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang naka-pin nga tab, Mahinungdanon, ug folder uban sa tanang sulod niini matangtang, ug ang ilang mga naabli nga tab masira."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بازدەرە چەسپاوەکان، ماڵپەڕە گرنگەکان و پۆشەکان بەگشتی ناوەڕۆکیانەوە لادەبرێن، و بازدەرە کراوەکانیان دادەخرێن."
          }
        },
        "co": {
          "stringUnit": {
            "state": "translated",
            "value": "L'unghjette fissate, l'essenziali è i cartulari cù tuttu ciò ch'elli cuntenenu sò cacciati, è e so unghjette aperte sò chjose."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připnuté panely, Oblíbené a složky se vším uvnitř budou odstraněny a jejich otevřené panely se zavřou."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Caiff tabiau wedi’u pinio, hanfodion a ffolderi, a phopeth sydd ynddyn nhw, eu tynnu, a chaiff eu tabiau agored eu cau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastgjorte faneblade, favoritter og mapper med alt indhold fjernes, og deres åbne faneblade lukkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Tabs, Favoriten und Ordner werden mitsamt ihrem Inhalt entfernt, und ihre geöffneten Tabs werden geschlossen."
          }
        },
        "dsb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pśipěte rejtariki, nejwažnjejše a zarědniki ze wšym, což w nich jo, se wótwónoźuju, a jich wócynjone rejtariki se zacynjaju."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καρφιτσωμένες καρτέλες, τα αγαπημένα και οι φάκελοι με όλο το περιεχόμενό τους αφαιρούνται, και οι ανοικτές καρτέλες τους κλείνουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned tabs, essentials and folders with everything inside them are removed, and their open tabs are closed."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinglitaj langetoj, esencaĵoj kaj dosierujoj kun ĉio enhavata estas forigataj, kaj iliaj malfermitaj langetoj fermiĝas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan las pestañas fijadas, los esenciales y las carpetas con todo su contenido, y se cierran sus pestañas abiertas."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borran las pestañas fijadas, los esenciales y las carpetas con todo su contenido, y se cierran sus pestañas abiertas."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borran las pestañas fijadas, los esenciales y las carpetas con todo su contenido, y se cierran sus pestañas abiertas."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan las pestañas fijadas, los esenciales y las carpetas con todo su contenido, y se cierran sus pestañas abiertas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan las pestañas fijadas, los esenciales y las carpetas con todo su contenido, y se cierran sus pestañas abiertas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinnitatud kaardid, olulised ja kaustad koos kogu nende sisuga eemaldatakse ning nende avatud kaardid suletakse."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Finkatutako fitxak, funtsezkoak eta karpetak, barruan dutenarekin batera, kendu egingo dira, eta beren fitxa irekiak itxi egingo dira."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زبانه‌های سنجاق‌شده، ضروریات و پوشه‌ها با هر چیزی که داخلشان است حذف می‌شوند و زبانه‌های باز آن‌ها بسته می‌شوند."
          }
        },
        "ff": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tabbe épinglées, essentiels et dossiers avec tout ce qu'ils contiennent sont supprimés, et leurs tabbe ouvertes se ferment."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnitetyt välilehdet, suosikit ja kansiot kaikkine sisältöineen poistetaan, ja niiden avoimet välilehdet suljetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets épinglés, favoris et dossiers sont supprimés avec tout leur contenu, et leurs onglets ouverts sont fermés."
          }
        },
        "fur": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis schedis fissadis, i essenziâi e lis cartelis cun dut ce che a àn dentri a vegnin gjavadis, e lis lôr schedis vierzudis a vegnin sieradis."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "Fêstsette ljepblêden, essinsjes en mappen mei alles derûnder wurde fuortsmiten, en har iepen ljepblêden wurde sluten."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Baintear cluaisíní greamaithe, riachtanais agus fillteáin, mar aon le gach rud atá iontu, agus dúntar a gcluaisíní oscailte."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Thèid tabaichean prìnichte, feumalachdan agus pasganan, còmhla ri gach nì a tha annta, a thoirt air falbh, agus thèid na tabaichean fosgailte aca a dhùnadh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "As lapelas fixadas, os esenciais e os cartafoles con todo o seu contido elimínanse, e as súas lapelas abertas péchanse."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Umi tendayke mboguapypyre, iporãvéva ha karpeta, opa mba'e ipype oĩva reheve, oñembogueta, ha umi tendayke ijurúva oñembotypa."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પિન કરેલી ટૅબ્સ, એસેન્શિયલ્સ અને ફોલ્ડર્સ તેમની અંદરની દરેક વસ્તુ સાથે દૂર કરવામાં આવશે, અને તેમની ખુલ્લી ટૅબ્સ બંધ કરવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשוניות מוצמדות, מועדפים ותיקיות עם כל מה שבתוכם מוסרים, והלשוניות הפתוחות שלהם נסגרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन किए गए टैब, एसेंशियल्स और फ़ोल्डर उनके अंदर की हर चीज़ के साथ हटा दिए जाएंगे, और उनके खुले टैब बंद कर दिए जाएंगे।"
          }
        },
        "hil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang naka-pin nga tab, Importante, kag folder lakip ang tanan nga sulod sini matangtang, kag ang ila bukas nga tab masira."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikvačene kartice, Favoriti i mape sa svime unutar njih se uklanjaju, a njihove otvorene kartice se zatvaraju."
          }
        },
        "hsb": {
          "stringUnit": {
            "state": "translated",
            "value": "Připjate rajtarki, najwažniše a zarjadniki ze wšěm, štož je w nich, so wotstronjeja, a jich wočinjene rajtarki so začinjeja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kitűzött lapok, kedvencek és mappák a teljes tartalmukkal együtt eltávolításra kerülnek, nyitott lapjaik pedig bezáródnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամրացված ներդիրները, կարևոր կայքերը և թղթապանակները՝ իրենց ողջ պարունակությամբ, կհեռացվեն, իսկ դրանց բաց ներդիրները կփակվեն."
          }
        },
        "ia": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedas fixate, essentiales e dossiers con toto lo que illes contine es removite, e lor schedas aperte es claudite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab yang disemat, situs penting, dan folder beserta semua isinya akan dihapus, dan tab yang terbuka akan ditutup."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Festir flipar, eftirlæti og möppur, með öllu sem í þeim er, eru fjarlægð, og opnir flipar þeirra eru lokaðir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede bloccate, i preferiti e le cartelle vengono rimossi con tutto il loro contenuto, e le relative schede aperte vengono chiuse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めタブ、よく使うサイト、フォルダーとその中身がすべて削除され、開いているタブは閉じます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მიმაგრებული ჩანართები, საჭირო საიტები და საქაღალდეები მთელი შემცველობით წაიშლება, ხოლო მათი გახსნილი ჩანართები დაიხურება."
          }
        },
        "kaa": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekitilgen betler, tiykarǵılar hám ishindegi hár nársesi menen papkalar óshiriledi, olardıń ashıq betleri jabıladı."
          }
        },
        "kab": {
          "stringUnit": {
            "state": "translated",
            "value": "Iccaren yessersen, ayen ilaqen d ikuramen akked wayen akk yellan degsen, ttwakksen, iccaren-nsen yeldin ttwamdalen."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бекітілген беттер, негізгілер және іші толған қалталар өшіріледі, олардың ашық беттері жабылады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទាំងបានខ្ទាស់ សំខាន់ៗ និងថតជាមួយអ្វីៗគ្រប់យ៉ាងនៅខាងក្នុងនឹងត្រូវដកចេញ ហើយផ្ទាំងដែលកំពុងបើករបស់ពួកវានឹងត្រូវបិទ។"
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilpekînên sabît, malperên girîng û peldank bi her tiştê di hundirê wan de têne rakirin, û hilpekînên wan ên vekirî têne girtin."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪಿನ್ ಮಾಡಿದ ಟ್ಯಾಬ್‌ಗಳು, ಅಗತ್ಯವಾದವು ಮತ್ತು ಫೋಲ್ಡರ್‌ಗಳು ಅವುಗಳೊಳಗಿನ ಎಲ್ಲದರ ಸಮೇತ ತೆಗೆದುಹಾಕಲ್ಪಡುತ್ತವೆ, ಮತ್ತು ಅವುಗಳ ತೆರೆದಿರುವ ಟ್ಯಾಬ್‌ಗಳು ಮುಚ್ಚಲ್ಪಡುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 탭, 필수 사이트, 폴더와 그 안의 모든 항목이 제거되고 열려 있던 탭이 닫힙니다."
          }
        },
        "kw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabow fastyes, Pythow Poesek ha plegellow gans pub tra a-berth ynnans a vydh removyes, ha'ga thabow igor a vydh degeys."
          }
        },
        "lij": {
          "stringUnit": {
            "state": "translated",
            "value": "I feuggi fissæ, i essençiali e e cartelle con tutto quello ch'o gh'è drento vegnan cacciæ, e i sò feuggi averti vegnan særæ."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແທັບທີ່ປັກໄວ້, ສິ່ງສຳຄັນ ແລະ ໂຟນເດີພ້ອມທຸກຢ່າງທີ່ຢູ່ໃນນັ້ນຈະຖືກເອົາອອກ, ແລະ ແທັບທີ່ເປີດຢູ່ຂອງພວກມັນຈະຖືກປິດ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisegtos kortelės, Mėgstamiausi ir aplankai su viskuo, kas juose yra, pašalinami, o jų atvertos kortelės užveriamos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piespraustās cilnes, Izlase un mapes ar visu to saturu tiek noņemtas, un to atvērtās cilnes tiek aizvērtas."
          }
        },
        "meh": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas fijadas, esenciales y carpetas con todo lo que tienen adentro se eliminan, y sus pestañas abiertas se cierran."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പിൻ ചെയ്ത ടാബുകൾ, പ്രധാനപ്പെട്ടവ, ഫോൾഡറുകൾ എന്നിവ അവയ്ക്കുള്ളിലെ എല്ലാം സഹിതം നീക്കം ചെയ്യപ്പെടും, അവയുടെ തുറന്ന ടാബുകൾ അടയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन केलेले टॅब, आवश्यक आणि फोल्डर आतील सर्व गोष्टींसह काढले जातील, आणि त्यांचे उघडे टॅब बंद केले जातील."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပင်ထိုးထားသော တက်ဗ်များ၊ မရှိမဖြစ်များနှင့် အထဲပါအားလုံးပါသော ဖိုင်တွဲများကို ဖယ်ရှားမည်ဖြစ်ပြီး ၎င်းတို့၏ ပွင့်နေသော တက်ဗ်များကို ပိတ်မည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Festede faner, favoritter og mapper med alt innholdet fjernes, og de åpne fanene deres lukkes."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन गरिएका ट्याबहरु, आवश्यक र फोल्डरहरु तिनभित्रका सबैसहित हटाइन्छन्, र तिनका खुला ट्याबहरु बन्द हुन्छन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastgemaakte tabbladen, favorieten en mappen worden met alles erin verwijderd, en de geopende tabbladen ervan worden gesloten."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Festa faner, favorittar og mapper med alt innhaldet vert fjerna, og dei opne fanene deira vert stengde."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Los onglets fixats, essencials e dossièrs, amb tot çò que contenon, son suprimits, e lors onglets dobèrts son tampats."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପିନ୍ କରାଯାଇଥିବା ଟ୍ୟାବ୍, ଆବଶ୍ୟକୀୟ ଏବଂ ଭିତରେ ଥିବା ସବୁ ଜିନିଷ ସହିତ ଫୋଲଡରଗୁଡ଼ିକ ହଟାଯିବ, ଏବଂ ସେମାନଙ୍କ ଖୋଲା ଟ୍ୟାବ୍ ବନ୍ଦ ହୋଇଯିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿੰਨ ਕੀਤੀਆਂ ਟੈਬਾਂ, ਜ਼ਰੂਰੀ ਅਤੇ ਫੋਲਡਰ ਆਪਣੇ ਅੰਦਰਲੀ ਹਰ ਚੀਜ਼ ਸਮੇਤ ਹਟਾ ਦਿੱਤੇ ਜਾਂਦੇ ਹਨ, ਅਤੇ ਇਹਨਾਂ ਦੀਆਂ ਖੁੱਲ੍ਹੀਆਂ ਟੈਬਾਂ ਬੰਦ ਕਰ ਦਿੱਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pa-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "پن کیتیاں ٹیباں، ضروری چیزاں تے فولڈر، انھاں دے اندر دی ہر شے سمیت ہٹا دتے جاندے نيں، تے انھاں دیاں کھلیاں ٹیباں بند ہو جاندیاں نيں۔"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypięte karty, ulubione i foldery są usuwane razem z całą zawartością, a ich otwarte karty są zamykane."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "پین شوي ټبونه، مهمې ویب پاڼې او پوښې له خپلو ټولو منځپانګو سره لرې کېږي، او د هغوی خلاص ټبونه بندېږي."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As abas fixadas, os essenciais e as pastas com tudo o que contêm são removidos, e as abas abertas deles são fechadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os separadores fixados, os essenciais e as pastas com tudo o que contêm são removidos, e os separadores abertos deles são fechados."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs fixads, essenzials e dossiers cun tut lur cuntegn vegnan allontanads, e lur tabs averts vegnan serrads."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Filele fixate, favorite și folderele, împreună cu tot conținutul lor, sunt eliminate, iar filele lor deschise se închid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённые вкладки, избранное и папки удаляются вместе со всем их содержимым, а их открытые вкладки закрываются."
          }
        },
        "sat": {
          "stringUnit": {
            "state": "translated",
            "value": "ᱯᱤᱱ ᱴᱮᱵᱽ ᱠᱚ, ᱮᱥᱮᱱᱥᱤᱭᱟᱞ ᱠᱚ ᱟᱨ ᱯᱷᱚᱞᱰᱚᱨ ᱠᱚ ᱟᱨ ᱟᱭᱢᱟᱛ ᱛᱟᱞᱟ ᱨᱮᱭᱟᱜ ᱡᱚᱛᱚ ᱚᱰᱚᱠ ᱦᱩᱭ ᱟ, ᱟᱨ ᱟᱭᱢᱟᱛ ᱡᱷᱤᱡᱽ ᱟᱠᱟᱱ ᱴᱮᱵᱽ ᱠᱚ ᱵᱚᱸᱫ ᱦᱩᱭ ᱟ ᱾"
          }
        },
        "sc": {
          "stringUnit": {
            "state": "translated",
            "value": "Is ischedas fissadas, is essentziales e is cartellas cun totu su chi ant a intro si che tirant, e is ischedas abertas issoro si serrant."
          }
        },
        "scn": {
          "stringUnit": {
            "state": "translated",
            "value": "I schedi ficcati, i essenziali e i carteddi cu tuttu chiddu ca ci hannu drintu vènunu luvati, e i sò schedi aperti vènunu chiusi."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "අමුණන ලද පටිති, අත්‍යවශ්‍යයන් සහ ඒවා තුළ ඇති සියල්ල සමඟ ෆෝල්ඩර ඉවත් කරනු ලැබේ, තවද ඒවායේ විවෘත පටිති වසනු ලැබේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripnuté karty, obľúbené a priečinky so všetkým, čo obsahujú, sa odstránia a ich otvorené karty sa zavrú."
          }
        },
        "skr": {
          "stringUnit": {
            "state": "translated",
            "value": "پن تھیاں ٹیباں، ضروری ٹیباں تے فولڈر، انہاں دے اندر دی ہر شئے سمیت، ہٹا ݙتے ویسن، تے انہاں دیاں کھلیاں ٹیباں بند تھی ویسن۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripeti zavihki, Izbrano in mape z vso vsebino se odstranijo, njihovi odprti zavihki pa se zaprejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Skedat e fiksuara, thelbësoret dhe dosjet, me gjithçka brenda tyre, hiqen, dhe skedat e tyre të hapura mbyllen."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Закачени језичци, Фаворити и фасцикле са свиме унутар њих се уклањају, а њихови отворени језичци се затварају."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab nu disemat, Penting, jeung map saeusina bakal dipiceun, sarta tab nu keur dibuka bakal ditutup."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fästa flikar, favoriter och mappar med allt som finns i dem tas bort, och deras öppna flikar stängs."
          }
        },
        "szl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przipiynte karty, nojważniejsze i foldry ze wszyskim, co je w nich, sōm wyciepowane, a jejich ôdewrzite karty sōm zawiyrane."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொருத்தப்பட்ட கீற்றுகள், முக்கியவை மற்றும் கோப்புறைகள் அவற்றுக்குள் உள்ள அனைத்துடனும் அகற்றப்படும், மேலும் அவற்றின் திறந்த கீற்றுகள் மூடப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పిన్ చేసిన ట్యాబులు, ముఖ్యమైనవి మరియు ఫోల్డర్లు వాటిలో ఉన్న ప్రతిదానితో సహా తీసివేయబడతాయి, మరియు వాటి తెరిచిన ట్యాబులు మూసివేయబడతాయి."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Варақаҳои часпонидашуда, сомонаҳои муҳим ва ҷузвдонҳо бо тамоми мӯҳтавои дохилашон нест карда мешаванд ва варақаҳои кушодаи онҳо пӯшида мешаванд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บที่ปักหมุด เว็บที่ใช้บ่อย และโฟลเดอร์พร้อมทุกอย่างภายในจะถูกลบ และแท็บที่เปิดอยู่จะถูกปิด"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aalisin ang mga naka-pin na tab, Mahahalaga, at folder pati na ang lahat ng laman ng mga ito, at isasara ang kanilang mga bukas na tab."
          }
        },
        "tok": {
          "stringUnit": {
            "state": "translated",
            "value": "poki awen, lipu suli, en tomo poki (kepeken ijo ale insa) li weka. poki open pi ona li pini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenmiş sekmeler, temel sekmeler ve içindeki her şeyle birlikte klasörler kaldırılır; açık sekmeleri de kapatılır."
          }
        },
        "trs": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas fijadas, esenciales y carpetas con todo lo que tienen adentro se eliminan, y sus pestañas abiertas se cierran."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Беркетелгән таблар, төп сайтлар һәм эчендәге һәрнәрсә белән бергә папкалар бетерелә, аларның ачык таблары ябыла."
          }
        },
        "tzm": {
          "stringUnit": {
            "state": "translated",
            "value": "Iseksal yessersen, ayen ilaqen d ikuramen akked wayen akkʷ yellan degsen, ttwakksen, iseksal-nsen yeldin ttwamdalen."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "مىخلانغان بەتكۈچلەر، مۇھىملار ۋە ئىچىدىكى ھەممە نەرسىسى بىلەن قىسقۇچلار ئۆچۈرۈلىدۇ، ئۇلارنىڭ ئوچۇق بەتكۈچلىرى تاقىلىدۇ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закріплені вкладки, обране і теки видаляються разом з усім їхнім вмістом, а їхні відкриті вкладки закриваються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پن کردہ ٹیبز، اہم اور فولڈرز اپنے اندر موجود ہر چیز سمیت ہٹا دیے جاتے ہیں، اور ان کے کھلے ٹیبز بند ہو جاتے ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahkamlangan varaqlar, muhimlar va ichidagi hamma narsasi bilan jildlar o'chiriladi, ularning ochiq varaqlari yopiladi."
          }
        },
        "vec": {
          "stringUnit": {
            "state": "translated",
            "value": "Schede fisà, essensiałi e cartełe co tuto quel che i ga drento i vien cavà via, e łe so schede verte i vien sarà."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ đã ghim, trang thiết yếu và thư mục cùng mọi thứ bên trong sẽ bị xóa, các thẻ đang mở của chúng cũng sẽ đóng lại."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "A óò yọ àwọn táàbù tí a fi Pin sí, Pàtàkì, àti fódà kúrò pẹ̀lú ohun gbogbo tí ó wà nínú wọn, a óò sì ti àwọn táàbù wọn tí ó ṣí."
          }
        },
        "yua": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas fijadas, esenciales y carpetas con todo lo que tienen adentro se eliminan, y sus pestañas abiertas se cierran."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定标签页、常用网站和文件夹及其中的所有内容都会被移除,已打开的标签页也会被关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已釘選分頁、常用網站與資料夾及其中的所有內容都會被移除,已開啟的分頁也會關閉。"
          }
        }
      }
    },

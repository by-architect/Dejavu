    "dejavu_external_links_private_summary": {
      "extractionState": "manual",
      "localizations": {
        "ab": {
          "stringUnit": {
            "state": "translated",
            "value": "Аԥшы апрограммақәа рахьтә алинкқәа ахатә аҭыԥ, аконтейнер ада, аартуп."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከሌሎች መተግበሪያዎች የሚመጡ አገናኞች ያለ መያዣ በግል የስራ ቦታ ውስጥ ይከፈታሉ።"
          }
        },
        "an": {
          "stringUnit": {
            "state": "translated",
            "value": "Os vinclos d'atras aplicacions s'ubren en l'espacio de treballo privau, sin contenedor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح الروابط من التطبيقات الأخرى في مساحة العمل الخاصة، بلا حاوية."
          }
        },
        "ast": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enllaces d'otres aplicaciones ábrense nel espaciu de trabayu privao, ensin contenedor."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Digər tətbiqlərdən keçidlər konteynersiz, məxfi iş sahəsində açılır."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "باشقا اپ‌لردن لینک‌لر کانتینرسیز، گیزلی ایش ساحه‌سینده آچیلیر."
          }
        },
        "ban": {
          "stringUnit": {
            "state": "translated",
            "value": "Link uli aplikasi lenan lakar mukak di genah pribadi, tanpa wadah."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасылкі з іншых праграм адкрываюцца ў прыватнай прасторы, без кантэйнера."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връзките от други приложения се отварят в поверителното работно пространство, без контейнер."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য অ্যাপ থেকে আসা লিঙ্কগুলো কন্টেইনার ছাড়াই ব্যক্তিগত ওয়ার্কস্পেসে খোলে।"
          }
        },
        "bqi": {
          "stringUnit": {

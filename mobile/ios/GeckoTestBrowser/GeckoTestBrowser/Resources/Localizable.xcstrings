    "dejavu_settings_tab_actions_entry_summary": {
      "extractionState": "manual",
      "localizations": {
        "ab": {
          "stringUnit": {
            "state": "translated",
            "value": "Абларҭақәа рҟны акнопкақәа, насгьы ивыбор шәыз абларҭақәа рзы аҟaҵарақәа"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በትሮች ላይ ያሉ አዝራሮች እና ለተመረጡ ትሮች የሚሆኑ እርምጃዎች"
          }
        },
        "an": {
          "stringUnit": {
            "state": "translated",
            "value": "Botons en as pestanyas, y accions ta las pestanyas seleccionadas"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأزرار على التبويبات، والإجراءات للتبويبات المحددة"
          }
        },
        "ast": {
          "stringUnit": {
            "state": "translated",
            "value": "Botones nes llingüetes, y aiciones pa les llingüetes seleicionaes"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vərəqlərdəki düymələr və seçilmiş vərəqlər üçün əməliyyatlar"
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "تاغلارداکی دوگمه‌لر و سئچیلمیش تاغلار اوچون عملیات‌لار"
          }
        },
        "ban": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol di tab, lan aksi anggon tab ane kapilih"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопкі на картках і дзеянні для выбраных картак"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бутони на разделите и действия за избраните раздели"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্যাবের বোতাম এবং নির্বাচিত ট্যাবের অ্যাকশন"
          }
        },
        "bqi": {
          "stringUnit": {
            "state": "translated",
            "value": "دکمه یل رو بلگه یل، و کار یل بره بلگه یل پسند وابیده"
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Afelloù war an ivinelloù, hag oberioù evit an ivinelloù diuzet"
          }
        },
        "brh": {

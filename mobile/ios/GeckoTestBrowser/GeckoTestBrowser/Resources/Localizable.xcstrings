    "dejavu_external_links_hint": {
      "extractionState": "manual",
      "localizations": {
        "ab": {
          "stringUnit": {
            "state": "translated",
            "value": "Аԥшы апрограммақәа рахьтә лашьцо алинкқәа ари аҭыԥ ма аконтейнераҿы иалагоит. «Шьҭахьҟа аара» ахь ашьҭахьҟа шәгаргылоит."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከሌሎች መተግበሪያዎች የሚከፍቷቸው አገናኞች በዚህ የስራ ቦታ እና መያዣ ውስጥ ይጀምራሉ። ተመለስ ወደ መተግበሪያው ይመልስዎታል።"
          }
        },
        "an": {
          "stringUnit": {
            "state": "translated",
            "value": "Os vinclos que ubres dende atras aplicacions ininician en este espacio de treballo y contenedor. Dezaga te torna a la aplicación."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الروابط التي تفتحها من تطبيقات أخرى تبدأ في مساحة العمل والحاوية هاتين. يعيدك زر السابق إلى التطبيق."
          }
        },
        "ast": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enllaces qu'abres dende otres aplicaciones entamen nesti espaciu de trabayu y contenedor. Atrás llévate otra vuelta a la aplicación."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Digər tətbiqlərdən açdığınız keçidlər bu iş sahəsində və konteynerdə başlayır. Geri düyməsi sizi tətbiqə qaytarır."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "باشقا اپ‌لردن آچدیغینیز لینک‌لر بو ایش ساحه‌سینده و کانتینرده باشلانیر. «دالیا» دوگمه‌سی سیزی اپه قایتاریر."
          }
        },
        "ban": {
          "stringUnit": {
            "state": "translated",
            "value": "Link ane bukak ragane uli aplikasi lenan lakar mulai di genah lan wadah ené. Mundur lakar mawali ragane ka aplikasine."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасылкі, якія вы адкрываеце з іншых праграм, пачынаюцца ў гэтай прасторы і кантэйнеры. Кнопка «Назад» вяртае вас у праграму."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връзките, които отваряте от други приложения, се отварят в това работно пространство и контейнер. Назад ви връща в приложението."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য অ্যাপ থেকে খোলা লিঙ্কগুলো এই ওয়ার্কস্পেস ও কন্টেইনারে খোলে। পিছনে গেলে আপনি আবার সেই অ্যাপে ফিরে যাবেন।"
          }
        },
        "bqi": {
          "stringUnit": {
            "state": "translated",
            "value": "لینک یلی که ز برنومه یل دیه گۊشی می‌کنی، من ای فضا و کانتینر شروع می‌بن. دیندا تره بر می‌گردنه برنومه."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Al liammoù a zigorit eus arloadoù all a gomz en egor labour ha kontener-mañ. Distreiñ a gas ac’hanoc’h en-dro d’an arload."
          }
        },
        "brh": {
          "stringUnit": {
            "state": "translated",
            "value": "نی ہور ایپاک نا مل کنا لنکاک اے ورک سپیس او کنٹینر اٹ شروع ہن۔ پدا بٹن نی نا ایپ ٹی نی واپس بر ہن۔"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkovi koje otvorite iz drugih aplikacija otvaraju se u ovom radnom prostoru i kontejneru. Nazad vas vraća u aplikaciju."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els enllaços que obriu des d'altres aplicacions comencen en aquest espai de treball i contenidor. En prémer Enrere tornareu a l'aplicació."
          }
        },
        "cak": {
          "stringUnit": {
            "state": "translated",
            "value": "Ri taq k'amab'äl ye'ajaq pa ch'aqa' chik chokoy, yejaq pa re samajib'äl chuqa' k'olib'äl re'. Ri “Chi rij” katzolin chik pa ri chokoy."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga link nga imong giablihan gikan sa ubang app magsugod niini nga workspace ug container. Ang Balik mobalik nimo sa app."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بەستەرەکانی کە لە بەرنامەی تر دەیانکەیتەوە لەم فەزا و کۆنتەینەرەدا دەستپێدەکەن. دوگمەی «دواوە» دەتگەڕێنێتەوە بۆ بەرنامەکە."
          }
        },
        "co": {
          "stringUnit": {
            "state": "translated",
            "value": "I liami chì apri da altre appiecazioni cumincianu in stu spaziu di travagliu è cuntenitore. Pagina precedente ti fa vultà à l'appiecazione."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkazy otevřené z jiných aplikací se otevřou v tomto pracovním prostoru a kontejneru. Tlačítko Zpět vás vrátí do aplikace."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae dolenni rydych chi’n eu hagor o apiau eraill yn dechrau yn y gweithle a’r cynhwysydd hwn. Mae Nôl yn mynd â chi’n ôl i’r ap."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, du åbner fra andre apps, starter i dette arbejdsområde og denne beholder. Tilbage fører dig tilbage til appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, die du aus anderen Apps öffnest, starten in diesem Arbeitsbereich und Container. „Zurück“ bringt dich wieder zur App zurück."
          }
        },
        "dsb": {
          "stringUnit": {
            "state": "translated",
            "value": "Wótkazy, kótarež z drugich nałoženjow wócynjaš, zachopinaju w toś tom źěłowem rumje a kontejnerje. Slědk śa wrośijo do nałoženja."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σύνδεσμοι που ανοίγετε από άλλες εφαρμογές ξεκινούν σε αυτόν τον χώρο εργασίας και περιέκτη. Το «Πίσω» σάς επιστρέφει στην εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links you open from other apps start in this workspace and container. Back takes you back to the app."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligiloj, kiujn vi malfermas el aliaj programoj, komenciĝas en ĉi tiu laborspaco kaj ujo. Retiro revenigas vin al la programo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces que abres desde otras aplicaciones se inician en este espacio de trabajo y contenedor. Atrás te lleva de vuelta a la aplicación."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces que abrís desde otras aplicaciones se inician en este espacio de trabajo y contenedor. Retroceder te lleva de vuelta a la aplicación."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces que abres desde otras aplicaciones se inician en este espacio de trabajo y contenedor. Retroceder te lleva de vuelta a la aplicación."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces que abres desde otras aplicaciones se inician en este espacio de trabajo y contenedor. Atrás te lleva de vuelta a la aplicación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces que abres desde otras aplicaciones se inician en este espacio de trabajo y contenedor. Atrás te lleva de vuelta a la aplicación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teistest äppidest avatud lingid avanevad selles tööruumis ja konteineris. Nupp Tagasi viib sind tagasi äppi."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beste aplikazioetatik irekitzen dituzun estekak laneremu eta edukiontzi honetan hasten dira. Atzera sakatuta, aplikaziora itzuliko zara."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیوندهایی که از برنامه‌های دیگر باز می‌کنید، در این فضای کاری و محفظه شروع می‌شوند. دکمهٔ بازگشت شما را به برنامه برمی‌گرداند."
          }
        },
        "ff": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens que tu ouvres depuis d'autres jaaɓnirgal démarrent dans cet espace de travail et conteneur. « Caggal » te ramène au jaaɓnirgal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muista sovelluksista avaamasi linkit avautuvat tähän työtilaan ja säiliöön. Takaisin-painike vie sinut takaisin sovellukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens que tu ouvres depuis d’autres applications démarrent dans cet espace et ce conteneur. « Retour » te ramène à l’application."
          }
        },
        "fur": {
          "stringUnit": {
            "state": "translated",
            "value": "I leams che tu vierzis di altris aplicazions a scomencin in chest spazi di lavôr e contenidôr. Indaûr al torne ae aplicazion."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "Keppelingen dy't jo iepenje fan oare apps begjinne yn dizze wurkromte en kontener. Tebek bringt jo werom nei de app."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tosaíonn naisc a osclaíonn tú ó aipeanna eile sa spás oibre agus sa choimeádán seo. Tugann Ar Ais ar ais go dtí an aip thú."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Bidh ceanglaichean a dh'fhosglas tu o aplacaidean eile a' tòiseachadh san àite-obrach agus san t-soitheach seo. Bheir Air ais air ais dhan aplacaid thu."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "As ligazóns que abras doutras aplicacións comezan neste espazo de traballo e contedor. Atrás lévate de volta á aplicación."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Umi enlace erecháva ambue tembiporu'ípe osẽ ko tembiapo renda ha ryru pype. “Tapykue” nde mbojevýta pe tembiporu'ípe."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અન્ય એપ્લિકેશનોમાંથી તમે ખોલો છો તે લિંક્સ આ વર્કસ્પેસ અને કન્ટેનરમાં ખૂલે છે. પાછા જવાથી તમે ફરી તે એપ્લિકેશન પર પહોંચો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קישורים שנפתחים מאפליקציות אחרות מתחילים במרחב העבודה ובמארז האלה. הכפתור חזרה מחזיר אתכם לאפליקציה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे ऐप से खोले गए लिंक इसी वर्कस्पेस और कंटेनर में खुलते हैं। वापस जाने पर आप उसी ऐप पर लौट आते हैं।"
          }
        },
        "hil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga link nga imo ginaabli halin sa iban nga app magasugod sa sini nga workspace kag container. Ang Balikan magabalik sa imo sa app."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poveznice koje otvorite iz drugih aplikacija otvaraju se u ovom radnom prostoru i spremniku. Natrag vas vraća u aplikaciju."
          }
        },
        "hsb": {
          "stringUnit": {
            "state": "translated",
            "value": "Wotkazy, kotrež z druhich nałoženjow wočinješ, so w tutym dźěłowym rumje a kontejnerje započinaja. Wróćo će zaso do nałoženja wjedźe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A más alkalmazásokból megnyitott hivatkozások ebben a munkaterületben és konténerben nyílnak meg. A Vissza gomb visszavisz az alkalmazásba."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այլ հավելվածներից բացված հղումները կբացվեն այս տարածքում և կոնտեյներում. Հետ գնալը ձեզ կվերադարձնի հավելված."
          }
        },
        "ia": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ligamines que tu aperi ab altere apps comencia in iste spatio de labor e recipiente. Retro te reconduce al app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan yang Anda buka dari aplikasi lain akan dimulai di ruang kerja dan wadah ini. Tombol kembali akan membawa Anda kembali ke aplikasi tersebut."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenglar sem þú opnar frá öðrum forritum byrja í þessu vinnusvæði og hólfi. Til baka fer þig aftur í forritið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link che apri da altre app partono in questo spazio e contenitore. «Indietro» ti riporta all’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリから開いたリンクは、このワークスペースとコンテナーで開きます。戻るボタンで元のアプリに戻ります。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვა აპებიდან გახსნილი ბმულები იხსნება ამ სივრცესა და კონტეინერში. „უკან“ დაგაბრუნებთ აპში."
          }
        },
        "kaa": {
          "stringUnit": {
            "state": "translated",
            "value": "Basqa baǵdarlamalardan ashqan siltemelerińiz usı jumıs maydanında hám konteynerde baslanadı. «Artqa» ashqan baǵdarlamańızǵa qaytaradı."
          }
        },
        "kab": {
          "stringUnit": {
            "state": "translated",
            "value": "Iseɣwan i teldiḍ seg yisnasen nniḍen bdan deg umkan-agi n umahil d usenduq-agi. “Ɣer deffir” ad k-id-yerr ɣer usnas."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа қолданбалардан ашқан сілтемелеріңіз осы жұмыс кеңістігінде және контейнерде басталады. «Артқа» түймесі сізді қолданбаға қайтарады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តំណភ្ជាប់ដែលអ្នកបើកពីកម្មវិធីផ្សេងទៀតនឹងចាប់ផ្ដើមនៅក្នុងចន្លោះការងារ និងកុងតឺន័រនេះ។ ប៊ូតុងថយក្រោយនឹងនាំអ្នកត្រឡប់ទៅកម្មវិធីវិញ។"
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girêdanên ku tu ji sepanên din vedikî, di vê qad û konteynerê de dest pê dikin. Bişkoka «Paşve» te vedigerîne sepanê."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಇತರ ಅನ್ವಯಿಕಗಳಿಂದ ತೆರೆಯುವ ಲಿಂಕ್‌ಗಳು ಈ ಕಾರ್ಯಕ್ಷೇತ್ರ ಮತ್ತು ಕಂಟೇನರ್‌ನಲ್ಲಿ ಆರಂಭವಾಗುತ್ತವೆ. ಹಿಂದಕ್ಕೆ ಬಟನ್ ನಿಮ್ಮನ್ನು ಆ ಅನ್ವಯಿಕಕ್ಕೆ ಹಿಂತಿರುಗಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱에서 여는 링크는 이 작업 공간과 컨테이너에서 시작됩니다. 뒤로 가기를 누르면 원래 앱으로 돌아갑니다."
          }
        },
        "kw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kevrennow a igerydh a app'ow erell a dhalleth y'n tyller-ober ha'n kontayner ma. War-dhelergh a'th dre arta dhe'n app."
          }
        },
        "lij": {
          "stringUnit": {
            "state": "translated",
            "value": "I ligammi che t'arvi da âtre app cominçan inte sto spaçio de travaggio e contenitô. Inderê o te porta torna à l'app."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລິ້ງທີ່ທ່ານເປີດຈາກ App ອື່ນຈະເລີ່ມຢູ່ໃນພື້ນທີ່ເຮັດວຽກ ແລະ ຄອນເທນເນີນີ້. ປຸ່ມກັບຄືນຈະພາທ່ານກັບໄປ App ນັ້ນ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuorodos, kurias atveriate iš kitų programų, atveriamos šioje darbo erdvėje ir konteineryje. Mygtukas Atgal grąžina jus į programą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saites, ko atverat no citām lietotnēm, tiek atvērtas šajā darbvietā un konteinerā. Poga Atpakaļ aizved jūs atpakaļ uz lietotni."
          }
        },
        "meh": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces que abres desde otras aplicaciones inician nuu este espacio de trabajo y contenedor. “Niko yata” te regresa a la aplicación."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ മറ്റ് ആപ്പുകളിൽ നിന്ന് തുറക്കുന്ന ലിങ്കുകൾ ഈ പണിയിടത്തിലും കണ്ടെയ്നറിലും തുടങ്ങും. പുറകോട്ട് ബട്ടൺ നിങ്ങളെ ആ ആപ്പിലേക്ക് തിരികെ കൊണ്ടുപോകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही इतर अ‍ॅपमधून उघडलेल्या लिंक या कार्यक्षेत्रात आणि कंटेनरमध्ये सुरू होतात. मागे बटण तुम्हाला त्या अ‍ॅपवर परत घेऊन जाते."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အခြားအက်ပ်များမှ သင်ဖွင့်သော လင့်ခ်များသည် ဤလုပ်ငန်းခွင်နှင့် ကွန်တိန်နာတွင် စတင်မည်။ နောက်သို့ ခလုတ်ကနေ အက်ပ်သို့ ပြန်ပို့ပေးမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenker du åpner fra andre apper, starter i dette arbeidsområdet og denne beholderen. Tilbake fører deg tilbake til appen."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले अन्य एपहरुबाट खोल्ने लिङ्कहरु यस कार्यक्षेत्र र कन्टेनरमा सुरु हुन्छन्। पछाडी बटनले तपाईंलाई त्यो एपमा फर्काउँछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Links die je vanuit andere apps opent, starten in deze werkruimte en container. Met “Terug” ga je weer naar de app."

          "stringUnit": {
            "state": "translated",
            "value": "Ji bo domandina hevdemkirinê, dîsa têkeve hesabê xwe yê Mozilla."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿಂಕ್ ಮುಂದುವರಿಸಲು ನಿಮ್ಮ Mozilla ಖಾತೆಗೆ ಮತ್ತೆ ಸೈನ್ ಇನ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 동기화하려면 Mozilla 계정에 다시 로그인하세요."
          }
        },
        "kw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sina ajy dhe'th akont Mozilla arta rag pesya kesunya."
          }
        },
        "lij": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a fâ l'accesso a-o tò conto Mozilla pe continoâ a sincronizzâ."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຂົ້າສູ່ລະບົບບັນຊີ Mozilla ຂອງທ່ານອີກຄັ້ງເພື່ອຊິງຄ໌ຕໍ່ໄປ."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vėl prisijunkite prie Mozilla paskyros, kad tęstumėte sinchronizavimą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesakieties Mozilla kontā vēlreiz, lai turpinātu sinhronizāciju."
          }
        },
        "meh": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión de nuevo en tu cuenta de Mozilla para seguir sincronizando."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിങ്ക് തുടരാൻ നിങ്ങളുടെ Mozilla അക്കൗണ്ടിലേക്ക് വീണ്ടും സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक सुरू ठेवण्यासाठी तुमच्या Mozilla खात्यात पुन्हा साइन इन करा."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "စင့်ခ်ဆက်လုပ်ရန် သင့် Mozilla အကောင့်သို့ ထပ်မံ ဝင်ရောက်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn på Mozilla-kontoen din på nytt for å fortsette å synkronisere."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक जारी राख्न आफ्नो Mozilla खातामा फेरि साइन इन गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld je opnieuw aan bij je Mozilla-account om te blijven synchroniseren."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn på Mozilla-kontoen din på nytt for å halde fram med å synkronisere."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectatz-vos a vòstre compte Mozilla per contunhar de sincronizar."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସିଙ୍କ ଜାରି ରଖିବାକୁ ପୁଣି ଆପଣଙ୍କ Mozilla ଆକାଉଣ୍ଟରେ ସାଇନ୍ ଇନ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿੰਕ ਜਾਰੀ ਰੱਖਣ ਲਈ ਆਪਣੇ Mozilla ਖਾਤੇ ਵਿੱਚ ਦੁਬਾਰਾ ਸਾਈਨ ਇਨ ਕਰੋ।"
          }
        },
        "pa-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "سنک جاری رکھن لئی اپݨے Mozilla اکاؤنٹ وچ دوبارہ سائن ان کرو۔"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się ponownie do konta Mozilli, aby kontynuować synchronizację."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د همغږۍ دوام لپاره بیا خپل Mozilla حساب ته ننوځئ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre novamente na sua conta da Mozilla para continuar sincronizando."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessão novamente na tua conta Mozilla para continuar a sincronizar."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "T’annunzia da nov tar tes conto Mozilla per cuntinuar a sincronisar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te din nou la contul tău Mozilla pentru a continua sincronizarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в аккаунт Mozilla снова, чтобы продолжить синхронизацию."
          }
        },
        "sat": {
          "stringUnit": {
            "state": "translated",
            "value": "ᱥᱤᱝᱠ ᱪᱟᱞᱩ ᱛᱟᱦᱮᱸ ᱞᱟᱹᱜᱤᱛ ᱫᱩᱦᱲᱟ ᱟᱢᱟᱜ Mozilla ᱟᱠᱟᱩᱱᱴ ᱨᱮ ᱥᱟᱭᱤᱱ ᱤᱱ ᱢᱮ ᱾"
          }
        },
        "sc": {
          "stringUnit": {
            "state": "translated",
            "value": "Intra torra in su contu Mozilla tuo pro sighire a sincronizare."
          }
        },
        "scn": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasi arrè nnô cuntu Mozilla tò pi cuntinuari a sincronizzari."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සමමුහුර්ත කිරීම දිගටම කරගෙන යාමට ඔබේ Mozilla ගිණුමට නැවත පිවිසෙන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova sa prihláste do svojho účtu Mozilla, aby ste mohli pokračovať v synchronizácii."
          }
        },
        "skr": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم وقت کرݨ جاری رکھݨ کیتے آپݨے Mozilla کھاتے نال ولدا سائن ان تھیوو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova se prijavite v svoj račun Mozilla, da nadaljujete s sinhronizacijo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bëni sërish hyrjen në llogarinë tuaj Mozilla që të vazhdoni njëkohësimin."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Поново се пријавите на свој Mozilla налог да наставите синхронизацију."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Asup deui kana akun Mozilla anjeun supaya bisa terus nyingkronkeun."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på ditt Mozilla-konto igen för att fortsätta synkronisera."
          }
        },
        "szl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj sie zaś do kōnta Mozilla, coby dalij synchronizować."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒத்திசைவைத் தொடர உங்கள் Mozilla கணக்கில் மீண்டும் உள்நுழையவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సింక్ కొనసాగించడానికి మీ Mozilla ఖాతాలోకి మళ్లీ సైన్ ఇన్ చేయండి."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои идомаи ҳамоҳангсозӣ бори дигар ба ҳисоби Mozilla-и худ ворид шавед."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้บัญชี Mozilla ของคุณอีกครั้งเพื่อซิงค์ต่อไป"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in ulit sa iyong Mozilla account para magpatuloy ang pag-sync."
          }
        },
        "tok": {
          "stringUnit": {
            "state": "translated",
            "value": "o kepeken sin e nimi Mozilla sina tawa awen sama."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşitlemeye devam etmek için Mozilla hesabınıza yeniden giriş yapın."
          }
        },
        "trs": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión de nuevo en tu cuenta de Mozilla para seguir sincronizando."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронлаштыруны дәвам итәр өчен Mozilla хисап язмагызга яңадан керегез."
          }
        },
        "tzm": {
          "stringUnit": {
            "state": "translated",
            "value": "Ales kcem ɣer umiḍan-ik Mozilla akken ad tkemmleḍ asdukel."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "قەدەمداشلاشنى داۋاملاشتۇرۇش ئۈچۈن Mozilla ھېساباتىڭىزغا قايتا كىرىڭ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть в обліковий запис Mozilla знову, щоб продовжити синхронізацію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم وقت سازی جاری رکھنے کے لیے دوبارہ اپنے Mozilla اکاؤنٹ میں سائن اِن کریں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinxronlashni davom ettirish uchun Mozilla hisobingizga qayta kiring."
          }
        },
        "vec": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra torna intel to account Mozilla par continuar a sincronizar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập lại vào tài khoản Mozilla để tiếp tục đồng bộ hóa."

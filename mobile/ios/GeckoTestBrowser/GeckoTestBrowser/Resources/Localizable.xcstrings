            "value": "Inicia sesión en tu cuenta de Mozilla para sincronizar tus espacios de trabajo con Zen."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu cuenta de Mozilla para sincronizar tus espacios de trabajo con Zen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tööruumide Zeniga sünkroonimiseks logi sisse oma Mozilla kontosse."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasi saioa zure Mozilla kontuan zure laneremuak Zenekin sinkronizatzeko."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای همگام‌سازی فضاهای کاری‌تان با Zen، به حساب Mozilla خود وارد شوید."
          }
        },
        "ff": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à ton compte Mozilla pour synchroniser tes espaces de travail avec Zen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu Mozilla-tilillesi synkronoidaksesi työtilasi Zenin kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à ton compte Mozilla pour synchroniser tes espaces avec Zen."
          }
        },
        "fur": {
          "stringUnit": {
            "state": "translated",
            "value": "Jentre tal to account Mozilla par sincronizâ i tiei spazis di lavôr cun Zen."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld jo oan by jo Mozilla-akkount om jo wurkromten mei Zen te syngronisearjen."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Sínigh isteach i do chuntas Mozilla chun do spásanna oibre a shioncronú le Zen."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Clàraich a-steach dhan chunntas Mozilla agad gus na h-àiteachan-obrach agad a shioncronachadh le Zen."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión na túa conta de Mozilla para sincronizar os teus espazos de traballo con Zen."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Eike ne kuenta Mozilla-pe resincronizar hağua ne tembiapo renda Zen ndive."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા વર્કસ્પેસને Zen સાથે સમન્વયિત કરવા માટે તમારા Mozilla એકાઉન્ટમાં સાઇન ઇન કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היכנסו לחשבון Mozilla שלכם כדי לסנכרן את מרחבי העבודה שלכם עם Zen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने वर्कस्पेस को Zen के साथ सिंक करने के लिए, अपने Mozilla अकाउंट में साइन इन करें।"
          }
        },
        "hil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in sa imo Mozilla account para i-sync ang imo mga workspace upod ang Zen."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se u svoj Mozilla račun za sinkronizaciju radnih prostora sa Zenom."
          }
        },
        "hsb": {
          "stringUnit": {
            "state": "translated",
            "value": "Přizjew so ze swojim kontom Mozilla, zo by swoje dźěłowe rumy z Zen synchronizował."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be Mozilla-fiókjába, hogy szinkronizálja munkaterületeit a Zennel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտք գործեք ձեր Mozilla հաշիվ՝ տարածքները Zen֊ի հետ համաժամացնելու համար."
          }
        },
        "ia": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperi session in tu conto Mozilla pro synchronisar tu spatios de labor con Zen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke akun Mozilla Anda untuk menyinkronkan ruang kerja dengan Zen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skráðu þig inn á Mozilla reikninginn þinn til að samstilla vinnusvæðin þín við Zen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi al tuo account Mozilla per sincronizzare i tuoi spazi con Zen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mozillaアカウントにサインインすると、ワークスペースをZenと同期できます。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შედით თქვენს Mozilla-ანგარიშში, რომ სივრცეები Zen-თან დაასინქრონოთ."
          }
        },
        "kaa": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumıs maydanlarıńızdı Zen penen sinxronlastırıw ushın Mozilla akkauntıńızǵa kiriń."
          }
        },
        "kab": {
          "stringUnit": {
            "state": "translated",
            "value": "Kcem ɣer umiḍan-ik Mozilla akken ad tesdukkuleḍ imukan n umahil-ik akked Zen."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жұмыс кеңістіктеріңізді Zen-мен синхрондау үшін Mozilla есептік жазбаңызға кіріңіз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចូលគណនី Mozilla របស់អ្នកដើម្បីធ្វើសមកាលកម្មចន្លោះការងាររបស់អ្នកជាមួយ Zen។"
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji bo hevdemkirina qadên xwe bi Zen re, têkeve hesabê xwe yê Mozilla."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen ಜೊತೆ ನಿಮ್ಮ ಕಾರ್ಯಕ್ಷೇತ್ರಗಳನ್ನು ಸಿಂಕ್ ಮಾಡಲು ನಿಮ್ಮ Mozilla ಖಾತೆಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mozilla 계정에 로그인하면 작업 공간을 Zen과 동기화할 수 있습니다."
          }
        },
        "kw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sina ajy dhe'th akont Mozilla rag kesunya dha dyleryow-ober gans Zen."
          }
        },
        "lij": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa l'accesso a-o tò conto Mozilla pe sincronizzâ i tò spaçi de travaggio con Zen."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຂົ້າສູ່ລະບົບບັນຊີ Mozilla ຂອງທ່ານເພື່ອຊິງຄ໌ພື້ນທີ່ເຮັດວຽກຂອງທ່ານກັບ Zen."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisijunkite prie Mozilla paskyros, kad sinchronizuotumėte darbo erdves su Zen."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesakieties savā Mozilla kontā, lai sinhronizētu darbvietas ar Zen."
          }
        },
        "meh": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu cuenta de Mozilla para sincronizar tus espacios de trabajo con Zen."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen യുമായി നിങ്ങളുടെ പണിയിടങ്ങൾ സിങ്ക് ചെയ്യാൻ നിങ്ങളുടെ Mozilla അക്കൗണ്ടിലേക്ക് സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen सह तुमची कार्यक्षेत्रे सिंक करण्यासाठी तुमच्या Mozilla खात्यात साइन इन करा."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့်လုပ်ငန်းခွင်များကို Zen နှင့် စင့်ခ်ချရန် သင့် Mozilla အကောင့်သို့ ဝင်ရောက်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn på Mozilla-kontoen din for å synkronisere arbeidsområdene dine med Zen."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen सँग आफ्ना कार्यक्षेत्रहरु सिंक गर्न आफ्नो Mozilla खातामा साइन इन गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld je aan bij je Mozilla-account om je werkruimtes met Zen te synchroniseren."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn på Mozilla-kontoen din for å synkronisere arbeidsområda dine med Zen."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectatz-vos a vòstre compte Mozilla per sincronizar vòstres espacis de trabalh amb Zen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen ସହିତ ଆପଣଙ୍କ କାର୍ଯ୍ୟକ୍ଷେତ୍ର ସିଙ୍କ କରିବାକୁ ଆପଣଙ୍କ Mozilla ଆକାଉଣ୍ଟରେ ସାଇନ୍ ଇନ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen ਨਾਲ ਆਪਣੀਆਂ ਵਰਕਸਪੇਸਾਂ ਸਿੰਕ ਕਰਨ ਲਈ ਆਪਣੇ Mozilla ਖਾਤੇ ਵਿੱਚ ਸਾਈਨ ਇਨ ਕਰੋ।"
          }
        },
        "pa-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen نال اپݨیاں ورک سپیساں سنک کرن لئی اپݨے Mozilla اکاؤنٹ وچ سائن ان کرو۔"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się do konta Mozilli, aby synchronizować obszary robocze z Zen."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "د خپلو ساحو له Zen سره همغږي کولو لپاره، خپل Mozilla حساب ته ننوځئ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre na sua conta da Mozilla para sincronizar seus espaços de trabalho com o Zen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessão na tua conta Mozilla para sincronizar os teus espaços de trabalho com o Zen."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "T’annunzia tar tes conto Mozilla per sincronisar tes spazis da lavur cun Zen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-te la contul tău Mozilla pentru a-ți sincroniza spațiile de lucru cu Zen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в аккаунт Mozilla, чтобы синхронизировать рабочие пространства с Zen."
          }
        },
        "sat": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen ᱢᱮᱫ ᱛᱮ ᱣᱟᱨᱠᱥᱯᱮᱥ ᱥᱤᱝᱠ ᱞᱟᱹᱜᱤᱛ ᱟᱢᱟᱜ Mozilla ᱟᱠᱟᱩᱱᱴ ᱨᱮ ᱥᱟᱭᱤᱱ ᱤᱱ ᱢᱮ ᱾"
          }
        },
        "sc": {
          "stringUnit": {
            "state": "translated",
            "value": "Intra in su contu Mozilla tuo pro sincronizare is ispàtzios de traballu tuos cun Zen."
          }
        },
        "scn": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasi nnô cuntu Mozilla tò pi sincronizzari i spazzii di travagghiu tò cu Zen."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen සමඟ ඔබේ අවකාශ සමමුහුර්ත කිරීමට ඔබේ Mozilla ගිණුමට පිවිසෙන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihláste sa do svojho účtu Mozilla, aby ste synchronizovali svoje pracovné priestory so Zenom."
          }
        },
        "skr": {
          "stringUnit": {
            "state": "translated",
            "value": "آپݨیاں ورک سپیساں Zen نال ہم وقت کرݨ کیتے آپݨے Mozilla کھاتے نال سائن ان تھیوو۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se v svoj račun Mozilla, da delovne prostore sinhronizirate z Zenom."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bëni hyrjen në llogarinë tuaj Mozilla që të njëkohësoni hapësirat tuaja të punës me Zen-in."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Пријавите се на свој Mozilla налог да синхронизујете радне просторе са Zen-ом."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Asup kana akun Mozilla anjeun pikeun nyingkronkeun rohangan anjeun jeung Zen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på ditt Mozilla-konto för att synkronisera dina arbetsytor med Zen."
          }
        },
        "szl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj sie do kōnta Mozilla, coby synchronizować twoje place z Zen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen உடன் உங்கள் பணியிடங்களை ஒத்திசைக்க உங்கள் Mozilla கணக்கில் உள்நுழையவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Zenతో మీ కార్యస్థలాలను సింక్ చేయడానికి మీ Mozilla ఖాతాలోకి సైన్ ఇన్ చేయండి."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Барои ҳамоҳанг кардани фазоҳоятон бо Zen, ба ҳисоби Mozilla-и худ ворид шавед."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้บัญชี Mozilla ของคุณเพื่อซิงค์พื้นที่ทำงานกับ Zen"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in sa iyong Mozilla account para i-sync ang iyong mga workspace kasama ang Zen."
          }
        },
        "tok": {
          "stringUnit": {
            "state": "translated",
            "value": "o kepeken nimi Mozilla sina tawa sama e kulupu poki sina kepeken Zen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma alanlarınızı Zen ile eşitlemek için Mozilla hesabınıza giriş yapın."
          }
        },
        "trs": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu cuenta de Mozilla para sincronizar tus espacios de trabajo con Zen."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Эш өлкәләрегезне Zen белән синхронлаштыру өчен Mozilla хисап язмагызга керегез."
          }
        },
        "tzm": {
          "stringUnit": {
            "state": "translated",
            "value": "Kcem ɣer umiḍan-ik Mozilla akken ad tesdukkuleḍ imukan n umahil-ik akked Zen."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "خىزمەت دائىرىلىرىڭىزنى Zen بىلەن قەدەمداشلاش ئۈچۈن Mozilla ھېساباتىڭىزغا كىرىڭ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть в обліковий запис Mozilla, щоб синхронізувати робочі простори з Zen."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی ورک اسپیسز کو Zen کے ساتھ ہم وقت کرنے کے لیے اپنے Mozilla اکاؤنٹ میں سائن اِن کریں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ish maydonlaringizni Zen bilan sinxronlashtirish uchun Mozilla hisobingizga kiring."
          }
        },
        "vec": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra intel to account Mozilla par sincronizar i to spasi de laoro co Zen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập vào tài khoản Mozilla để đồng bộ hóa không gian làm việc của bạn với Zen."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Wọlé sí àkáǹtì Mozilla rẹ láti ṣe sync àwọn ibi-iṣẹ́ rẹ pẹ̀lú Zen."
          }
        },
        "yua": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu cuenta de Mozilla para sincronizar tus espacios de trabajo con Zen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录您的 Mozilla 账户,即可将工作区与 Zen 同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入您的 Mozilla 帳號,即可將工作區與 Zen 同步。"

    "dejavu_workspace_container_hint": {
      "extractionState": "manual",
      "localizations": {
        "ab": {
          "stringUnit": {
            "state": "translated",
            "value": "Ари аҭыԥ иабларҭақәа ҿыцқәа ари аконтейнераҿы аартуп."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የዚህ የስራ ቦታ አዲስ ትሮች በዚህ መያዣ ውስጥ ይከፈታሉ።"
          }
        },
        "an": {
          "stringUnit": {
            "state": "translated",
            "value": "As pestanyas nuevas d'este espacio de treballo s'ubren en este contenedor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح التبويبات الجديدة في مساحة العمل هذه ضمن هذه الحاوية."
          }
        },
        "ast": {
          "stringUnit": {
            "state": "translated",
            "value": "Les llingüetes nueves d'esti espaciu de trabayu ábrense nesti contenedor."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iş sahəsinin yeni vərəqləri bu konteynerdə açılır."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "بو ایش ساحه‌سینین یئنی تاغلاری بو کانتینرده آچیلیر."
          }
        },
        "ban": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab anyar uli genah ené lakar mukak di wadah ené."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Новыя карткі гэтай прасторы адкрываюцца ў гэтым кантэйнеры."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Новите раздели на това работно пространство се отварят в този контейнер."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ওয়ার্কস্পেসের নতুন ট্যাবগুলো এই কন্টেইনারে খোলে।"
          }
        },
        "bqi": {
          "stringUnit": {
            "state": "translated",
            "value": "بلگه یل نۊ ای فضا من ای کانتینر گۊشی می‌بن."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "An ivinelloù nevez eus an egor labour-mañ a zigor er c’hontener-mañ."

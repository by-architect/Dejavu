    "dejavu_sync_zen_hint": {
      "extractionState": "manual",
      "localizations": {
        "ab": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen аҟны, «Архиарақәа» аартын, унтi «Асинхронизация», насгьы аҭаны панель расинхронизациа алагаз. Ификсациам абларҭақәа расинхронизациа мап."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በZen ውስጥ ቅንብሮችን፣ ከዚያም Syncን ይክፈቱ፣ እና የጎን አሞሌ ማመሳሰልን ያብሩ። ያልተሰኩ ትሮች አይመሳሰሉም።"
          }
        },
        "an": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, ubre Achustes, dimpués Sincronización, y activa la sincronización de la barra lateral. As pestanyas que no son fixadas no se sincronizan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في Zen، افتح الإعدادات ثم المزامنة، وفعّل مزامنة الشريط الجانبي. التبويبات غير المثبتة لا تُزامَن."
          }
        },
        "ast": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, abri Configuración, dempués Sincronización, y activa la sincronización de la barra llateral. Les llingüetes que nun tán fixaes nun se sincronicen."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-də Tənzimləmələri, sonra Sinxronlaşdırmanı açın və yan panel sinxronlaşdırmasını aktivləşdirin. Bərkidilməmiş vərəqlər sinxronlaşdırılmır."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-ده تنظیم‌لری، سونرا همگام‌سازینی آچین و یان پانل همگام‌سازی‌سینی فعاللاشدیرین. برکیدیلمه‌میش تاغلار همگام‌سازی اولونمور."
          }
        },
        "ban": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Zen, bukak Settings, lantas Sync, lan idupang sidebar sync. Tab ane tusing kasemat tusing kasinkron."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У Zen адкрыйце Налады, затым Сінхранізацыю, і ўключыце сінхранізацыю бакавой панэлі. Незамацаваныя карткі не сінхранізуюцца."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В Zen отворете Настройки, после Синхронизиране, и включете синхронизирането на страничния панел. Разделите, които не са закачени, не се синхронизират."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-এ সেটিংস, তারপর Sync খুলুন এবং সাইডবার Sync চালু করুন। পিন না করা ট্যাব Sync হয় না।"
          }
        },
        "bqi": {
          "stringUnit": {
            "state": "translated",
            "value": "من Zen، «سامووا» ره وا کو، بعد «همگام کردن»، و همگام کردن نوار پهلو ره روشن کو. بلگه یلی که سنجاق نوابیدن همگام نمی‌بن."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "E Zen, digorit Arventennoù, ha goude Goubredañ, ha weredekait goubredañ ar varrenn gostez. An ivinelloù dispilhennet ne vezont ket goubredet."
          }
        },
        "brh": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen اٹ، سیٹنگاک مل، پہ Sync، او سائیڈبار سنک آن کبو۔ جہ ٹیباک پن نی ہن اے سنک نی ہن۔"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U Zenu otvorite Postavke, zatim Sinhronizacija, i uključite sinhronizaciju bočne trake. Tabovi koji nisu prikvačeni se ne sinhronizuju."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Al Zen, obriu Configuració, després Sincronització, i activeu la sincronització de la barra lateral. Les pestanyes no fixades no se sincronitzen."
          }
        },
        "cak": {
          "stringUnit": {
            "state": "translated",
            "value": "Pa Zen, tajäq Nuk'ulem, k'a ri' Junamirisanik, k'a ri' tatzija' ri junamirisanik richin sidebar. Ri taq ruwi' man ximon ta man ye junamirisäx ta."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Zen, ablihi ang Settings, dayon Sync, ug i-on ang sidebar sync. Ang mga tab nga dili naka-pin dili ma-sync."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لە Zen دا، «ڕێکخستنەکان» بکەرەوە، پاشان «هاوکاتکردن»، و هاوکاتکردنی لاتەنیشت چالاک بکە. بازدەرەکانی کە چەسپاو نین هاوکات ناکرێن."
          }
        },
        "co": {
          "stringUnit": {
            "state": "translated",
            "value": "In Zen, apre Parametri, dopu Sincrunizazione, è attivate a sincrunizazione di a barra laterale. L'unghjette micca fissate ùn sò micca sincrunizate."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Zen otevřete Nastavení, poté Synchronizaci, a zapněte synchronizaci bočního panelu. Nepřipnuté panely se nesynchronizují."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn Zen, agorwch Gosodiadau, yna Sync, a throwch cydweddu’r bar ochr ymlaen. Nid yw tabiau heb eu pinio’n cael eu cydweddu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Indstillinger i Zen, derefter Synkronisering, og slå synkronisering af sidepanelet til. Faneblade, der ikke er fastgjort, synkroniseres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in Zen die Einstellungen, dann Sync, und aktiviere die Synchronisierung der Seitenleiste. Nicht angeheftete Tabs werden nicht synchronisiert."
          }
        },
        "dsb": {
          "stringUnit": {
            "state": "translated",
            "value": "W Zen wócyni Nastajenja, pón Synchronizacija, a zapopń synchronizaciju bócnicy. Rejtariki, kótarež njejsu pśipěte, se njesynchronizěruju."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο Zen, ανοίξτε τις Ρυθμίσεις, μετά τον Συγχρονισμό, και ενεργοποιήστε τον συγχρονισμό της πλευρικής γραμμής. Οι καρτέλες που δεν είναι καρφιτσωμένες δεν συγχρονίζονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Zen, open Settings, then Sync, and turn on sidebar sync. Tabs that are not pinned are not synced."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, malfermu Agordojn, poste Sinkronigon, kaj ŝaltu sinkronigon de la flanka breto. Langetoj, kiuj ne estas pinglitaj, ne estas sinkronigataj."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, abre Ajustes y luego Sincronización, y activa la sincronización de la barra lateral. Las pestañas que no están fijadas no se sincronizan."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, abrí Ajustes y luego Sincronización, y activá la sincronización de la barra lateral. Las pestañas que no están fijadas no se sincronizan."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, abre Ajustes y luego Sincronización, y activa la sincronización de la barra lateral. Las pestañas que no están fijadas no se sincronizan."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, abre Ajustes y luego Sincronización, y activa la sincronización de la barra lateral. Las pestañas que no están fijadas no se sincronizan."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, abre Ajustes y luego Sincronización, y activa la sincronización de la barra lateral. Las pestañas que no están fijadas no se sincronizan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava Zenis Sätted, siis Sünkroonimine, ja lülita sisse külgriba sünkroonimine. Kinnitamata kaarte ei sünkroonita."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zenen, ireki Ezarpenak, ondoren Sinkronizazioa, eta aktibatu albo-barraren sinkronizazioa. Finkatu gabeko fitxak ez dira sinkronizatzen."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در Zen، تنظیمات و سپس همگام‌سازی را باز کنید و همگام‌سازی نوارکناری را روشن کنید. زبانه‌های سنجاق‌نشده همگام‌سازی نمی‌شوند."
          }
        },
        "ff": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Zen, ouvre Paramètres, puis Synchronisation, et active la synchronisation de la barre latérale. Les tabbe qui ne sont pas épinglées ne sont pas synchronisées."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Zenissä Asetukset, sitten Synkronointi, ja ota sivupalkin synkronointi käyttöön. Välilehdet, joita ei ole kiinnitetty, eivät synkronoidu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Zen, ouvre les paramètres, puis Synchronisation, et active la synchronisation de la barre latérale. Les onglets non épinglés ne sont pas synchronisés."
          }
        },
        "fur": {
          "stringUnit": {
            "state": "translated",
            "value": "In Zen, vierç Impostazions, dopo Sincronizazion, e ative la sincronizazion de sbare laterâl. Lis schedis che no son fissadis no vegnin sincronizadis."
          }
        },
        "fy": {
          "stringUnit": {
            "state": "translated",
            "value": "Iepenje yn Zen de Ynstellingen, dan Syngronisaasje, en set de syngronisaasje fan de sidebalke oan. Ljepblêden dy't net fêstsetten binne, wurde net syngronisearre."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "I Zen, oscail Socruithe, ansin Sioncrónú, agus cuir sioncrónú an bharra taoibh ar siúl. Ní shioncronaítear cluaisíní nach bhfuil greamaithe."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "translated",
            "value": "Ann an Zen, fosgail Roghainnean, an uairsin Sioncronachadh, agus cuir air sioncronachadh a' bhàr-thaoibh. Cha tèid tabaichean neo-phrìnichte a shioncronachadh."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, abre Configuración e logo Sincronización, e activa a sincronización da barra lateral. As lapelas que non están fixadas non se sincronizan."
          }
        },
        "gn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-pe, embojuruja Ñemboheko, upéi Sincronizar, ha emyendy pe sidebar sincronización. Umi tendayke mboguapypyre'ỹva nosincronizahái."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen માં સેટિંગ્સ, પછી સમન્વયન ખોલો અને સાઇડબાર સમન્વયન ચાલુ કરો. પિન ન કરેલી ટૅબ્સ સમન્વયિત થતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-Zen, פתחו את ההגדרות, ואז את הסנכרון, והפעילו את סנכרון סרגל הצד. לשוניות שאינן מוצמדות אינן מסונכרנות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen में सेटिंग और फिर सिंक खोलें, और साइडबार सिंक चालू करें। जो टैब पिन नहीं किए गए हैं, वे सिंक नहीं होते।"
          }
        },
        "hil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Zen, abrihan ang Settings, dayon Sync, kag i-on ang sidebar sync. Ang mga tab nga indi naka-pin indi ma-sync."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U Zenu otvorite Postavke, zatim Sinkronizacija, i uključite sinkronizaciju bočne trake. Kartice koje nisu prikvačene se ne sinkroniziraju."
          }
        },
        "hsb": {
          "stringUnit": {
            "state": "translated",
            "value": "W Zen wočini Nastajenja, potom Synchronizacija, a zapinaj synchronizaciju bóčnicy. Rajtarki, kotrež njejsu připjate, so njesynchronizuja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Zenben nyissa meg a Beállításokat, majd a Szinkronizálást, és kapcsolja be az oldalsó sáv szinkronizálását. A nem kitűzött lapok nem szinkronizálódnak."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen֊ում բացեք «Կարգավորումներ», ապա «Համաժամացում» և միացրեք կողային վահանակի համաժամացումը. Չամրացված ներդիրները չեն համաժամացվում."
          }
        },
        "ia": {
          "stringUnit": {
            "state": "translated",
            "value": "In Zen, aperi Parametros, postea Synchronisation, e activa le synchronisation del barra lateral. Le schedas que non es fixate non es synchronisate."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Zen, buka Pengaturan, lalu Sinkronisasi, dan aktifkan sinkronisasi sidebar. Tab yang tidak disemat tidak akan disinkronkan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í Zen skaltu opna Stillingar, svo Samstillingu, og kveikja á samstillingu hliðarstikunnar. Flipar sem eru ekki festir eru ekki samstilltir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Zen, apri Impostazioni, poi Sincronizzazione, e attiva la sincronizzazione della barra laterale. Le schede non bloccate non vengono sincronizzate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zenで「設定」を開き、「同期」でサイドバーの同期をオンにしてください。ピン留めしていないタブは同期されません。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-ში გახსენით „პარამეტრები“, შემდეგ „სინქრონიზაცია“ და ჩართეთ გვერდითი პანელის სინქრონიზაცია. მიუმაგრებელი ჩანართები არ სინქრონდება."
          }
        },
        "kaa": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-de Sazlawlardı, soń Sinxronlastırıwdı ashıń hám yan panel sinxronlastırıwın qosıń. Bekitilmegen betler sinxronlastırılmaydı."
          }
        },
        "kab": {
          "stringUnit": {
            "state": "translated",
            "value": "Deg Zen, ldi Iɣewwaṛen, sakin Asdukel, rnu sermed asdukel n ugalis adisan. Iccaren ur nesrusi ara ur ttwasdukklen ara."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-де Баптауларды, содан кейін Синхрондауды ашыңыз және бүйірлік тақта синхрондауын қосыңыз. Бекітілмеген беттер синхрондалмайды."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅក្នុង Zen បើកការកំណត់ បន្ទាប់មកសមកាលកម្ម ហើយបើកសមកាលកម្មរបារចំហៀង។ ផ្ទាំងដែលមិនបានខ្ទាស់មិនត្រូវបានធ្វើសមកាលកម្មទេ។"
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Zen de, «Sazkarî» veke, paşê «Hevdemkirin», û hevdemkirina darika kêlekê vekirî bike. Hilpekînên ku ne sabît in nayên hevdemkirin."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen ನಲ್ಲಿ, ಸಿದ್ಧತೆಗಳನ್ನು ತೆರೆದು, ನಂತರ ಸಿಂಕ್ ಅನ್ನು ತೆರೆದು, ಸೈಡ್‌ಬಾರ್ ಸಿಂಕ್ ಅನ್ನು ಆನ್ ಮಾಡಿ. ಪಿನ್ ಮಾಡದ ಟ್ಯಾಬ್‌ಗಳು ಸಿಂಕ್ ಆಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen에서 설정을 연 다음 동기화에서 사이드바 동기화를 켜세요. 고정되지 않은 탭은 동기화되지 않습니다."
          }
        },
        "kw": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn Zen, igeri Settyansow, ena Kesunyans, ha treylya yn ban kesunyans an barr-esedh. Tabow nag yns fastyes ny vydhons kesunys."
          }
        },
        "lij": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte Zen, arvi Inpostaçioin, poi Sincronizzaçion, e attivi a sincronizzaçion de a barra laterale. I feuggi che no son fissæ no vegnan sincronizæ."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃນ Zen, ເປີດການຕັ້ງຄ່າ, ແລ້ວໄປທີ່ Sync, ແລະ ເປີດການຊິງຄ໌ແຖບຂ້າງ. ແທັບທີ່ບໍ່ໄດ້ປັກໄວ້ຈະບໍ່ຖືກຊິງຄ໌."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen naršyklėje atverkite Nuostatos, tada Sinchronizavimas, ir įjunkite šoninės juostos sinchronizavimą. Neprisegtos kortelės nesinchronizuojamos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen atveriet Iestatījumi, tad Sinhronizācija, un ieslēdziet sānjoslas sinhronizāciju. Cilnes, kas nav piespraustas, netiek sinhronizētas."
          }
        },
        "meh": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, abre Configuración, luego Sincronización, y activa la sincronización de la barra lateral. Las pestañas que no están fijadas no se sincronizan."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-ൽ, ക്രമീകരണങ്ങൾ തുറന്ന്, പിന്നെ സിങ്ക് തുറന്ന്, സൈഡ്‌ബാർ സിങ്ക് ഓൺ ചെയ്യുക. പിൻ ചെയ്യാത്ത ടാബുകൾ സിങ്ക് ആകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen मध्ये, सेटिंग उघडा, नंतर सिंक, आणि साइडबार सिंक सुरू करा. पिन न केलेले टॅब सिंक होत नाहीत."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen တွင် Settings ကိုဖွင့်ပြီး Sync ကို ရွေးပါ၊ ထို့နောက် sidebar sync ကို ဖွင့်ပါ။ ပင်မထိုးထားသော တက်ဗ်များကို စင့်ခ်ချမည် မဟုတ်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Innstillinger i Zen, deretter Synkronisering, og slå på synkronisering av sidepanelet. Faner som ikke er festet, synkroniseres ikke."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen मा, सेटिङ्ग खोल्नुहोस्, त्यसपछि सिंक, र साइडबार सिंक खोल्नुहोस्। पिन नगरिएका ट्याबहरु सिंक हुँदैनन्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Zen Instellingen, dan Synchronisatie, en zet synchronisatie van de zijbalk aan. Tabbladen die niet zijn vastgemaakt, worden niet gesynchroniseerd."
          }
        },
        "nn": {
          "stringUnit": {
            "state": "translated",
            "value": "Opne Innstillingar i Zen, deretter Synkronisering, og slå på synkronisering av sidestolpen. Faner som ikkje er festa, vert ikkje synkroniserte."
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Dins Zen, dobrissètz Paramètres, puèi Sincronizacion, e activatz la sincronizacion de la barra laterala. Los onglets pas fixats son pas sincronizats."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen ରେ, ସେଟିଂସମୂହ ଖୋଲନ୍ତୁ, ତାପରେ ସିଙ୍କ, ଏବଂ ସାଇଡବାର ସିଙ୍କ ଅନ୍ କରନ୍ତୁ। ପିନ୍ ହୋଇନଥିବା ଟ୍ୟାବ୍ ସିଙ୍କ ହୁଏ ନାହିଁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen ਵਿੱਚ, ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ, ਫਿਰ ਸਿੰਕ, ਅਤੇ ਸਾਈਡਬਾਰ ਸਿੰਕ ਚਾਲੂ ਕਰੋ। ਜਿਹੜੀਆਂ ਟੈਬਾਂ ਪਿੰਨ ਨਹੀਂ ਕੀਤੀਆਂ, ਉਹ ਸਿੰਕ ਨਹੀਂ ਹੁੰਦੀਆਂ।"
          }
        },
        "pa-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen وچ، سیٹنگاں کھولھو، فیر Sync، تے سائیڈبار سنک آن کرو۔ جیہڑیاں ٹیباں پن نئيں کیتیاں اوہ سنک نئيں ہُندیاں۔"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Zen otwórz Ustawienia, potem Synchronizację, i włącz synchronizację paska bocznego. Nieprzypięte karty nie są synchronizowane."
          }
        },
        "ps": {
          "stringUnit": {
            "state": "translated",
            "value": "په Zen کې، «امستنې» خلاص کړئ، بیا «همغږي کول»، او د څنګ پټې همغږي فعاله کړئ. هغه ټبونه چې پین شوي نه دي همغږي نه کېږي."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Zen, abra Configurações e depois Sincronização, e ative a sincronização da barra lateral. Abas que não estão fixadas não são sincronizadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No Zen, abre Definições e depois Sincronização, e ativa a sincronização da barra lateral. Separadores que não estão fixados não são sincronizados."
          }
        },
        "rm": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, avra Parameters, lura Sync, ed activescha la sincronisaziun da la trav laterala. Tabs betg fixads na vegnan betg sincronisads."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În Zen, deschide Setări, apoi Sincronizare, și activează sincronizarea barei laterale. Filele care nu sunt fixate nu sunt sincronizate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Zen откройте «Настройки», затем «Синхронизация», и включите синхронизацию боковой панели. Незакреплённые вкладки не синхронизируются."
          }
        },
        "sat": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen ᱨᱮ, ᱥᱟᱡᱟᱣ ᱡᱷᱤᱡᱽ ᱢᱮ, ᱚᱱᱟ ᱛᱟᱭᱚᱢ ᱥᱤᱝᱠ, ᱟᱨ ᱥᱟᱭᱰᱵᱟᱨ ᱥᱤᱝᱠ ᱚᱱ ᱢᱮ ᱾ ᱵᱟᱝ ᱯᱤᱱ ᱴᱮᱵᱽ ᱠᱚ ᱥᱤᱝᱠ ᱵᱟᱭ ᱦᱩᱭ ᱟ ᱾"
          }
        },
        "sc": {
          "stringUnit": {
            "state": "translated",
            "value": "In Zen, aberi Cunfiguratzione, a pustis Sincronizatzione, e ativa sa sincronizatzione de sa barra laterale. Is ischedas chi no sunt fissadas no si sincronizant."
          }
        },
        "scn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nta Zen, grapi Mpustazzioni, doppu Sincronizzazzioni, e attiva a sincronizzazzioni dâ barra laterali. I schedi ca non sunnu ficcati non vènunu sincronizzati."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen හි, සැකසුම් විවෘත කර, පසුව Sync තෝරා, පැති තීරු සමමුහුර්තකරණය ක්‍රියාත්මක කරන්න. අමුණා නැති පටිති සමමුහුර්ත නොවේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V Zene otvorte Nastavenia, potom Synchronizáciu, a zapnite synchronizáciu bočného panela. Karty, ktoré nie sú pripnuté, sa nesynchronizujú."
          }
        },
        "skr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen وچ ترتیباں کھولو، ول ہم وقت کرݨ، تے سائیڈ بار ہم وقت کرݨ چالو کرو۔ جہڑیاں ٹیباں پن کائنی، اوہ ہم وقت کائنی تھیندیاں۔"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V Zenu odprite Nastavitve, nato Sinhronizacija, in vklopite sinhronizacijo stranske vrstice. Zavihki, ki niso pripeti, se ne sinhronizirajo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Në Zen, hapni Rregullime, mandej Njëkohësim, dhe aktivizoni njëkohësimin e panelit anësor. Skedat që nuk janë të fiksuara nuk njëkohësohen."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "У Zen-у отворите Подешавања, затим Синхронизација, и укључите синхронизацију бочне траке. Језичци који нису закачени се не синхронизују."
          }
        },
        "su": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina Zen, buka Settings, tuluy Sync, jeung hurungkeun sidebar sync. Tab nu teu disemat moal disingkronkeun."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I Zen öppnar du Inställningar, sedan Synkronisering, och slår på synkronisering av sidofältet. Flikar som inte är fästa synkroniseras inte."
          }
        },
        "szl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Zen ôdewrzij Sztalōnki, potym Synchronizacyjo, i włōncz synchronizacyjo bocznego posku. Karty, kere niy sōm przipiynte, niy sōm synchronizowane."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-இல், அமைவுகளைத் திறந்து, பிறகு ஒத்திசைவைத் திறந்து, பக்கப்பட்டி ஒத்திசைவை இயக்கவும். பொருத்தப்படாத கீற்றுகள் ஒத்திசைக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Zenలో, అమరికలు తెరిచి, తర్వాత సింక్‌ను తెరిచి, సైడ్‌బార్ సింక్‌ను ఆన్ చేయండి. పిన్ చేయని ట్యాబులు సింక్ కావు."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дар Zen «Танзимот»-ро кушоед, сипас «Ҳамоҳангсозӣ»-ро ва ҳамоҳангсозии сутуни паҳлӯро фаъол кунед. Варақаҳое, ки часпонида нашудаанд, ҳамоҳанг намешаванд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Zen ให้เปิดการตั้งค่า จากนั้นไปที่การซิงค์ และเปิดใช้งานการซิงค์แถบด้านข้าง แท็บที่ไม่ได้ปักหมุดจะไม่ถูกซิงค์"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Zen, buksan ang Settings, pagkatapos ay Sync, at i-on ang sidebar sync. Hindi sini-sync ang mga tab na hindi naka-pin."
          }
        },
        "tok": {
          "stringUnit": {
            "state": "translated",
            "value": "lon Zen, o open e nasin ilo, la o open e sama, la o ken e sama pi poki poka. poki awen ala li sama ala."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen'de Ayarlar'ı, ardından Eşitleme'yi açın ve kenar çubuğu eşitlemesini açın. Sabitlenmemiş sekmeler eşitlenmez."
          }
        },
        "trs": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, abre Configuración, luego Sincronización, y activa la sincronización de la barra lateral. Las pestañas que no están fijadas no se sincronizan."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-дә Көйләүләрне, аннары Синхронлаштыруны ачыгыз һәм як панель синхронлаштыруын кабызыгыз. Беркетелмәгән таблар синхронлаштырылмый."
          }
        },
        "tzm": {
          "stringUnit": {
            "state": "translated",
            "value": "Deg Zen, rẓem Tisɣal, sakin Asdukel, rnu sermed asdukel n ugalis adisan. Iseksal ur nesrusi ara ur ttwasdukklen ara."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen دا تەڭشەكنى، ئاندىن قەدەمداشلاشنى ئېچىڭ ۋە يان پانېل قەدەمداشلىشىنى ئېچىڭ. مىخلانمىغان بەتكۈچلەر قەدەمداشلانمايدۇ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Zen відкрийте «Налаштування», потім «Синхронізацію», і увімкніть синхронізацію бічної панелі. Незакріплені вкладки не синхронізуються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen میں، سیٹنگز کھولیں، پھر سنک، اور سائیڈ بار ہم وقت سازی کو آن کریں۔ وہ ٹیبز جو پن نہیں کیے گئے ہم وقت نہیں ہوتے۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-da Sozlamalarni, keyin Sinxronlashtirishni oching va yon panel sinxronlashini yoqing. Mahkamlanmagan varaqlar sinxronlashtirilmaydi."
          }
        },
        "vec": {
          "stringUnit": {
            "state": "translated",
            "value": "In Zen, verxi Inpostasion, dopo Sincronizasion, e ativa ła sincronizasion de ła bara łaterałe. Łe schede mìa fisà no łe vien sincronizà."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Zen, mở Cài đặt, rồi vào Đồng bộ hóa, và bật đồng bộ hóa thanh bên. Các thẻ chưa ghim sẽ không được đồng bộ hóa."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Nínú Zen, ṣí Settings, lẹ́yìn náà Sync, kí o sì tan sidebar sync. A kì í ṣe sync àwọn táàbù tí a kò fi Pin sí."
          }
        },
        "yua": {
          "stringUnit": {
            "state": "translated",
            "value": "En Zen, abre Configuración, luego Sincronización, y activa la sincronización de la barra lateral. Las pestañas que no están fijadas no se sincronizan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Zen 中打开“设置”,然后进入“同步”,开启侧边栏同步。未固定的标签页不会同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Zen 中開啟「設定」,再進入「同步」,開啟側邊欄同步。未釘選的分頁不會同步。"
          }
        }
      }
    },

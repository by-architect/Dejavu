    "dejavu_custom_action_examples_hint": {
      "extractionState": "manual",
      "localizations": {
        "ab": {
          "stringUnit": {
            "state": "translated",
            "value": "Аҟны иҟоу аҭыԥқәа рыдкылара азы, апример аҟны идырҳәыр. Убри аҵыхәала example.com ахь ихатә сервер шәаргылан, насгьы дуӡӡа ажәытә ала иҩыз аҟынтә ихатә акәажәара ма ID шәаргылан."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከላይ ያሉትን መስኮች ለመሙላት አንድ ምሳሌ ይንኩ። ከዚያ በexample.com ምትክ የራስዎን አገልጋይ፣ በትላልቅ ፊደላት በተጻፉት ክፍሎች ምትክ ደግሞ የራስዎን ቁልፎች እና መታወቂያዎች ያስገቡ።"
          }
        },
        "an": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un exemplo ta replenar os campos de dalto. Dimpués posa o tuyo propio servidor en cuenta de example.com, y as tuyas propias claus y IDs en cuenta d'as partes en mayusclas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على مثال لملء الحقول أعلاه. ثم استبدل example.com بخادمك الخاص، والأجزاء بأحرف كبيرة بمفاتيحك ومعرّفاتك الخاصة."
          }
        },
        "ast": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un exemplu pa rellenar los campos d'enriba. Dempués pon el to propiu sirvidor en llugar de example.com, y les tos propies claves ya IDs en llugar de les partes en mayúscules."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuxarıdakı sahələri doldurmaq üçün bir nümunəyə toxunun. Sonra example.com yerinə öz serverinizi, böyük hərflərlə yazılmış hissələr yerinə isə öz açar və ID-lərinizi yazın."
          }
        },
        "azb": {
          "stringUnit": {
            "state": "translated",
            "value": "یوخاریداکی ساحه‌لری دولدورماق اوچون بیر نومونه‌یه توخونون. سونرا example.com یئرینه اؤز سرورونوزو، بؤیوک حرفلرله یازیلمیش حیصصه‌لر یئرینه ایسه اؤز آچار و ID-لرینیزی یازین."
          }
        },
        "ban": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap conto anggon ngisi kolom di baduur. Lantas anggon server padidi, tusing example.com, lan key lan ID padidi, tusing bagian ane matulis gede."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Націсніце на прыклад, каб запоўніць палі вышэй. Затым замяніце example.com сваім уласным серверам, а часткі вялікімі літарамі — сваімі ключамі і ідэнтыфікатарамі."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете пример, за да попълните полетата по-горе. След това поставете свой сървър вместо example.com, а свои ключове и идентификатори вместо частите с главни букви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উপরের ফিল্ডগুলো পূরণ করতে একটি উদাহরণে ট্যাপ করুন। তারপর example.com-এর জায়গায় আপনার নিজের সার্ভার এবং বড় হাতের অক্ষরে লেখা অংশের জায়গায় আপনার নিজের কী ও আইডি বসান।"
          }
        },
        "bqi": {
          "stringUnit": {
            "state": "translated",
            "value": "رو یه نمونه بزن تا جا یل بالا پر وابن. بعد جای example.com سرور خودته بذار، و جای اون تیکه یلی که با حروف بزرگ نوشته وابیده، کلید و ID خودته بذار."
          }
        },
        "br": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouezit war ur skouer evit leuniañ ar maeziennoù a-us. Lakait neuze ho servijer ho-unan e-lec’h example.com, hag ho alc’hwezioù hag ID ho-unan e-lec’h al lodennoù e pennlizherennoù."
          }
        },
        "brh": {
          "stringUnit": {
            "state": "translated",
            "value": "اُتلین فیلڈاک بھرننا نا واسطے مثال پار ٹیپ کبو۔ پہ example.com نا جاگہ اٹ اپنا سرور، او وڈا حرفاک نا حصاک نا جاگہ اٹ اپنا کی او ID دے۔"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite primjer da popunite polja iznad. Zatim umjesto example.com upišite svoj server, a umjesto dijelova velikim slovima svoje ključeve i ID-ove."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toqueu un exemple per emplenar els camps de dalt. Després, substituïu example.com pel vostre propi servidor, i les parts en majúscules per les vostres claus i identificadors."
          }
        },
        "cak": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapitz'a' jun ejemplo richin natz'aqatisaj retal pa ri kasil kok wi chuwäch. K'a ri' tayaka' ri awonil server pa ruk'exel example.com, chuqa' ri awonil taq k'exel chuqa' ID pa kik'exel ri tzij ye tz'ib'an pa taq nima tz'ib'."
          }
        },
        "ceb": {
          "stringUnit": {
            "state": "translated",
            "value": "i-Tap ang usa ka panig-ingnan para pun-on ang mga field sa ibabaw. Dayon ibutang ang imong kaugalingong server puli sa example.com, ug ang imong kaugalingong mga key ug ID puli sa mga bahin nga naka-capital."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دەست لەسەر نموونەیەک بدە بۆ پڕکردنەوەی خانەکانی سەرەوە. پاشان سێرڤەری خۆت لە جیاتی example.com دابنێ، و کلیل و ئایدییەکانی خۆت لە جیاتی ئەو بەشانەی کە بە پیتی گەورە نووسراون."
          }
        },
        "co": {
          "stringUnit": {
            "state": "translated",
            "value": "Picchia nant'à un esempiu per riempie i campi quì sopra. Dopu metti u to servitore in locu di example.com, è e to chjave è ID in locu di e parti in maiuscule."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na příklad vyplníte pole výše. Pak místo example.com zadejte svůj server a místo částí velkými písmeny svoje klíče a ID."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Pwyswch enghraifft i lenwi’r meysydd uchod. Yna rhowch eich gweinydd eich hun yn lle example.com, a’ch allweddi a’ch IDau eich hun yn lle’r rhannau mewn priflythrennau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et eksempel for at udfylde felterne ovenfor. Erstat derefter example.com med din egen server, og delene med store bogstaver med dine egne nøgler og id'er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Beispiel, um die obigen Felder auszufüllen. Setze dann deinen eigenen Server anstelle von example.com sowie deine eigenen Schlüssel und IDs anstelle der großgeschriebenen Teile ein."
          }
        },
        "dsb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłoc na pśikład, aby póla górjejce wupołnił. Pón daj swój włosny serwer město example.com, a swóje włosne kluce a ID město dźělow z wjelikimi pismikami."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα παράδειγμα για να συμπληρωθούν τα παραπάνω πεδία. Στη συνέχεια, βάλτε τον δικό σας διακομιστή στη θέση του example.com, και τα δικά σας κλειδιά και αναγνωριστικά στη θέση των τμημάτων με κεφαλαία γράμματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap an example to fill in the fields above. Then put your own server in place of example.com, and your own keys and IDs in place of the parts in capitals."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuŝu ekzemplon por plenigi la suprajn kampojn. Poste anstataŭigu example.com per via propra servilo, kaj la majusklajn partojn per viaj propraj ŝlosiloj kaj identigiloj."
          }

          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ligams que dobrissètz dempuèi d’autras aplicacions se dobrisson dins aqueste espaci de trabalh e contenidor. Tornar vos ramena a l’aplicacion."

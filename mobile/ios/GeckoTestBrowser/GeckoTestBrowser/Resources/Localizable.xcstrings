        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપરનાં ફીલ્ડ ભરવા માટે કોઈ ઉદાહરણ પર ટૅપ કરો. પછી example.com ની જગ્યાએ તમારું પોતાનું સર્વર અને કેપિટલ અક્ષરોવાળા ભાગોની જગ્યાએ તમારી પોતાની કી અને ID મૂકો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על דוגמה כדי למלא את השדות שלמעלה. לאחר מכן הציבו את השרת שלכם במקום example.com, ואת המפתחות והמזהים שלכם במקום החלקים באותיות גדולות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर के फ़ील्ड भरने के लिए किसी उदाहरण पर टैप करें। फिर example.com की जगह अपना सर्वर, और कैपिटल अक्षरों वाले हिस्सों की जगह अपनी कुंजियां और ID डालें।"
          }
        },
        "hil": {
          "stringUnit": {
            "state": "translated",
            "value": "i-Tap ang isa ka halimbawa para pun-on ang mga field sa ibabaw. Dayon ibutang ang imo kaugalingon nga server sa baylo sang example.com, kag ang imo kaugalingon nga mga key kag ID sa baylo sang mga bahin nga naka-capital."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite primjer za popunjavanje gornjih polja. Zatim umjesto example.com upišite svoj poslužitelj, a umjesto dijelova velikim slovima svoje ključeve i ID-ove."
          }
        },
        "hsb": {
          "stringUnit": {
            "state": "translated",
            "value": "Podótkń so přikłada, zo by pola horjeka wupjelnił. Potom daj swój własny serwer město example.com, a swoje własne kluče a ID město dźělow z wulkimi pismikami."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson egy példára a fenti mezők kitöltéséhez. Ezután cserélje le az example.com-ot a saját szerverére, valamint a nagybetűs részeket a saját kulcsaira és azonosítóira."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հպեք օրինակին՝ վերևի դաշտերը լրացնելու համար. Այնուհետև example.com֊ի փոխարեն նշեք ձեր սերվերը, իսկ մեծատառերով նշված հատվածների փոխարեն՝ ձեր բանալիներն ու ID֊ները."
          }
        },
        "ia": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa un exemplo pro plenar le campos ci supra. Postea pone tu proprie servitor in loco de example.com, e tu proprie claves e IDs in loco del partes in majusculas."

            "state": "translated",
            "value": "Inicia sesión en tu cuenta de Mozilla para sincronizar tus espacios de trabajo con Zen."
          }
        },
        "es-CL": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en tu cuenta de Mozilla para sincronizar tus espacios de trabajo con Zen."
          }

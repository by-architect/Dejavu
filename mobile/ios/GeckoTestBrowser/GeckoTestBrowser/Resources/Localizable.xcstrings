          "stringUnit": {
            "state": "translated",
            "value": "மற்ற செயலிகளில் இருந்து வரும் இணைப்புகள் கமுக்கப் பணியிடத்தில், கொள்கலன் இன்றித் திறக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇతర అనువర్తనాల నుండి లింకులు అంతరంగిక కార్యస్థలంలో, కంటైనర్ లేకుండా తెరుచుకుంటాయి."
          }
        },
        "tg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайвандҳо аз барномаҳои дигар дар фазои хусусӣ, бе контейнер, кушода мешаванд."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์จากแอปอื่นจะเปิดในพื้นที่ทำงานส่วนตัว โดยไม่มีคอนเทนเนอร์"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga link mula sa ibang app ay bubukas sa pribadong workspace, nang walang container."
          }
        },
        "tok": {
          "stringUnit": {
            "state": "translated",
            "value": "nasin lipu tan ilo ante li open lon kulupu poki pi nasin len, leko ala."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamalardan gelen bağlantılar, kapsayıcı olmadan gizli çalışma alanında açılır."
          }
        },
        "trs": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de otras aplicaciones se abren en el espacio de trabajo huìt, sin contenedor."
          }
        },
        "tt": {
          "stringUnit": {
            "state": "translated",
            "value": "Башка кушымталардан сылтамалар контейнерсез, хосусый эш өлкәсендә ачыла."
          }
        },
        "tzm": {
          "stringUnit": {
            "state": "translated",
            "value": "Iseɣwan seg tsensiyin nniḍen ttildin g umkan n umahil uslig, war asenduq."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "باشقا ئەپلەردىن ئۇلانمىلار قاچىسىز، شەخسىي خىزمەت دائىرىسىدە ئېچىلىدۇ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання з інших застосунків відкриваються в приватному робочому просторі, без контейнера."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسری ایپس کے لنکس نجی ورک اسپیس میں، بغیر کنٹینر کے، کھلتے ہیں۔"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Boshqa ilovalardan havolalar konteynersiz, maxfiy ish maydonida ochiladi."
          }
        },
        "vec": {
          "stringUnit": {
            "state": "translated",
            "value": "I łinchi da altre app i se verxe intel spasio de laoro anonimo, sensa contenidor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết từ ứng dụng khác sẽ mở trong không gian làm việc riêng tư, không có vùng chứa."
          }
        },
        "yo": {
          "stringUnit": {
            "state": "translated",
            "value": "Àwọn líǹkì láti àwọn áàpù mìíràn yóò ṣí nínú ibi-iṣẹ́ ìkọ̀kọ̀, láìsí container."
          }
        },
        "yua": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de otras aplicaciones se abren en el espacio de trabajo privado, mina'an contenedor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自其他应用的链接会在隐私工作区中打开,且不使用容器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自其他應用程式的連結會在隱私工作區中開啟,且不使用容器。"
          }
        }
      }
    },

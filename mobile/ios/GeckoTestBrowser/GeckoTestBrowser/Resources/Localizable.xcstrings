        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשיר אחר משתמש בגרסה חדשה יותר של סנכרון מרחבים. עדכנו את Dejavu כדי להמשיך לסנכרן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरा डिवाइस स्पेस सिंक का नया वर्शन इस्तेमाल करता है। सिंक जारी रखने के लिए Dejavu को अपडेट करें।"
          }
        },
        "hil": {
          "stringUnit": {
            "state": "translated",
            "value": "May iban nga device nga nagagamit sang mas bag-o nga bersyon sang spaces sync. i-Update ang Dejavu para magpadayon ang pag-sync."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi uređaj koristi noviju verziju sinkronizacije Spaces. Ažurirajte Dejavu da biste nastavili sinkronizaciju."
          }
        },
        "hsb": {
          "stringUnit": {
            "state": "translated",
            "value": "Druhi grat wužiwa nowšu wersiju synchronizacije space. Aktualizuj Dejavu, zo by dale synchronizował."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy másik eszköz a munkaterület-szinkronizálás újabb verzióját használja. Frissítse a Dejavut a szinkronizálás folytatásához."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մեկ այլ սարք օգտագործում է տարածքների համաժամացման ավելի նոր տարբերակ. Համաժամացումը շարունակելու համար թարմացրեք Dejavu֊ն."
          }
        },
        "ia": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altere apparato usa un version plus nove del synchronisation de spatios. Actualisa Dejavu pro continuar a synchronisar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat lain menggunakan versi sinkronisasi Spaces yang lebih baru. Perbarui Dejavu untuk terus menyinkronkan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Annað tæki notar nýrri útgáfu af samstillingu vinnusvæða. Uppfærðu Dejavu til að halda áfram að samstilla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro dispositivo usa una versione più recente della sincronizzazione degli spazi. Aggiorna Dejavu per continuare a sincronizzare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の端末がより新しいバージョンのSpaces同期を使用しています。同期を続けるにはDejavuを更新してください。"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სხვა მოწყობილობა სივრცეების სინქრონიზაციის უფრო ახალ ვერსიას იყენებს. სინქრონიზაციის გასაგრძელებლად განაახლეთ Dejavu."
          }
        },
        "kaa": {
          "stringUnit": {
            "state": "translated",
            "value": "Basqa qurılma Spaces sinxronlastırıwınıń jańalaw nusqasın qollanadı. Sinxronlastırıwdı dawam etiw ushın Dejavu-nı jańalań."
          }
        },
        "kab": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibenk nniḍen yesseqdac lqem ijdiden n usdukel n imukan. Leqqem Dejavu akken ad tkemmleḍ asdukel."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Басқа құрылғы Spaces синхрондауының жаңарақ нұсқасын пайдаланады. Синхрондауды жалғастыру үшін Dejavu-ды жаңартыңыз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឧបករណ៍មួយទៀតកំពុងប្រើកំណែថ្មីជាងនៃសមកាលកម្ម spaces។ ធ្វើបច្ចុប្បន្នភាព Dejavu ដើម្បីបន្តធ្វើសមកាលកម្ម។"
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amûreke din guhertoyeke nûtir a hevdemkirina qadan bi kar tîne. Ji bo domandina hevdemkirinê, Dejavu nû bike."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೊಂದು ಸಾಧನ ಕಾರ್ಯಕ್ಷೇತ್ರ ಸಿಂಕ್‌ನ ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ಬಳಸುತ್ತಿದೆ. ಸಿಂಕ್ ಮುಂದುವರಿಸಲು Dejavu ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기가 더 최신 버전의 Spaces 동기화를 사용하고 있습니다. 계속 동기화하려면 Dejavu를 업데이트하세요."
          }
        },
        "kw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jynn aral a usy versyon nowedhessa a gesunyans spasow. Nowedhi Dejavu rag pesya kesunya."
          }
        },
        "lij": {
          "stringUnit": {

            "value": "Botones en las pestañas, y acciones para pestañas seleccionadas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签页上的按钮,以及选中标签页时的操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分頁上的按鈕,以及選取分頁時的操作"
          }

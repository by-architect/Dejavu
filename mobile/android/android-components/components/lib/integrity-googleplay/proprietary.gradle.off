// Dejavu: the Play Integrity API is closed source. F-Droid's recipe deletes this file, and
// build.gradle then compiles src/foss/java, which keeps this module's API and issues no tokens.

def catalog = project.extensions.getByType(org.gradle.api.artifacts.VersionCatalogsExtension).named('libs')

android {
    sourceSets.main.kotlin.srcDirs += 'src/proprietary/java'
}

dependencies {
    implementation catalog.findLibrary('kotlinx-coroutines-play-services').get()
    implementation catalog.findLibrary('play-integrity').get()
}

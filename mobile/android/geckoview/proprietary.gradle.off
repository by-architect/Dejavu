// Dejavu: Google Play's FIDO library is closed source, so F-Droid will not build a GeckoView that
// declares it. Its recipe deletes this file; build.gradle then compiles src/foss/java, whose
// WebAuthn bridge keeps the same JNI entry points and goes through Android's own credential
// manager instead.

def catalog = project.extensions.getByType(org.gradle.api.artifacts.VersionCatalogsExtension).named('libs')

android {
    sourceSets.main.java.srcDirs += 'src/proprietary/java'
}

dependencies {
    implementation catalog.findLibrary('play-services-fido').get()
}

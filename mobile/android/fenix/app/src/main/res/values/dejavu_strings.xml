    <string name="dejavu_sync_problem_needs_update">Another device uses a newer version of spaces sync. Update Dejavu to keep syncing.</string>
    <string name="dejavu_sync_problem_sign_in">Sign in to your Mozilla account again to keep syncing.</string>
    <string name="dejavu_sync_problem_offline">Could not reach the sync servers. Dejavu will try again.</string>

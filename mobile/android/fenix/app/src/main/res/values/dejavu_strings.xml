    <string name="dejavu_sync_normal_tabs">Include unpinned tabs</string>
    <string name="dejavu_sync_normal_tabs_summary">Also sync the other tabs of each workspace, not just pinned tabs and folders. Zen syncs them when its own Include unpinned tabs option is on.</string>

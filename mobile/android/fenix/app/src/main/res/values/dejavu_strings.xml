    <string name="dejavu_sync_choose_about">Sync your workspaces with Firefox or Zen Browser on your computer, through the Mozilla account you sync Firefox data with.</string>
    <!-- Sync settings, while workspaces sync with Firefox. -->
    <string name="dejavu_sync_firefox_about">Shows the open tabs of Firefox on each of your computers and phones as a workspace, and keeps them up to date. It uses the Mozilla account you sync Firefox data with.</string>
    <!-- Sync settings, below the other settings while workspaces sync with Firefox. -->
    <string name="dejavu_sync_firefox_hint">In Firefox, open Settings, then Sync, and keep Open tabs on. Tabs you open or close in the workspace of a device open or close there too. Tabs in your other workspaces stay on this device, and Firefox lists them under your other devices.</string>
    <!-- Summary of the "Include unpinned tabs" switch while workspaces sync with Firefox. -->
    <string name="dejavu_sync_normal_tabs_firefox_summary">Also show the tabs that are neither pinned nor in a tab group, not just pinned tabs and tab groups.</string>

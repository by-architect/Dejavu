    <!-- Settings -->
    <string name="dejavu_settings_title">Dejavu</string>
    <string name="dejavu_about_content">%1$s एक स्वतंत्र ब्राउज़र है, जिसे Mozilla के ओपन सोर्स Firefox और GeckoView कोड से बनाया गया है। इसे न तो Mozilla ने बनाया है, न ही Mozilla इसका समर्थन करता है या इसके लिए सहायता देता है। Firefox, अमेरिका और दूसरे देशों में Mozilla Foundation का ट्रेडमार्क है।</string>
    <string name="dejavu_about_source_code">सोर्स कोड</string>
    <string name="dejavu_settings_tab_actions">टैब ऐक्शन</string>
    <string name="dejavu_settings_tab_actions_entry_summary">ऐक्शन की एक सूची, और हर ऐक्शन कहां दिखता है</string>
    <string name="dejavu_settings_tab_actions_hint">आपके खुद जोड़े गए ऐक्शन समेत, सभी ऐक्शन एक ही सूची में हैं। चुनें कि हर ऐक्शन कहां दिखे: पिन किए गए टैब, बिना पिन वाले टैब और फ़ोल्डर पर, चुने गए टैब के बार में, और विकल्प मेन्यू में, तथा पेज के नीचे वाले ऐक्शन बार में। किसी फ़ोल्डर पर किया गया ऐक्शन उसके अंदर के हर टैब पर लागू होता है।</string>

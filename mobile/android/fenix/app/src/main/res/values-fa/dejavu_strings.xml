    <string name="dejavu_sync_syncing">در حال همگام‌سازی…</string>
    <string name="dejavu_sync_last_synced">آخرین همگام‌سازی %1$s</string>
    <string name="dejavu_sync_never_synced">هنوز همگام‌سازی نشده</string>
    <string name="dejavu_sync_off">همگام‌سازی در این دستگاه خاموش است</string>
    <string name="dejavu_sync_signed_out">برای همگام‌سازی فضاهای کاری‌تان با Zen، به حساب Mozilla خود وارد شوید.</string>
    <string name="dejavu_sync_sign_in">ورود</string>
    <string name="dejavu_sync_problem_not_set_up">در انتظار پایان یافتن راه‌اندازی حساب شما توسط Firefox Sync.</string>
    <string name="dejavu_sync_problem_not_turned_on">همگام‌سازی فضاها برای حساب Mozilla شما خاموش است. آن را از همین‌جا یا از تنظیمات همگام‌سازی Zen روشن کنید. روشن کردن آن از اینجا، آن را در Zen هم روشن می‌کند.</string>
    <string name="dejavu_sync_turn_on">روشن کردن همگام‌سازی فضاها</string>
    <string name="dejavu_sync_problem_needs_update">دستگاه دیگری از نسخهٔ جدیدتر همگام‌سازی فضاها استفاده می‌کند. برای ادامهٔ همگام‌سازی، Dejavu را به‌روزرسانی کنید.</string>
    <string name="dejavu_sync_problem_sign_in">برای ادامهٔ همگام‌سازی، دوباره به حساب Mozilla خود وارد شوید.</string>
    <string name="dejavu_sync_problem_offline">اتصال به سرورهای همگام‌سازی ممکن نشد. Dejavu دوباره تلاش خواهد کرد.</string>
    <string name="dejavu_sync_problem_server">سرورهای همگام‌سازی با مشکلی مواجه شدند. Dejavu دوباره تلاش خواهد کرد.</string>

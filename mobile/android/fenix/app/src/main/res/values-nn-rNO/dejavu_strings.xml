    <string name="dejavu_sync_switch_from_zen">Arbeidsområde frå Zen vert verande i Dejavu, men vert ikkje lenger synkroniserte.</string>
    <string name="dejavu_sync_switch_from_firefox">Arbeidsområda til Firefox-einingane dine forsvinn frå Dejavu. Firefox beheld fanene deira.</string>

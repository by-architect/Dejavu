    <string name="dejavu_sync_found_firefox">Dæti de Firefox trovæ</string>
    <string name="dejavu_sync_found_zen">Dæti de Zen trovæ</string>
    <string name="dejavu_sync_found_no_firefox">Nisciun dæto de Firefox trovou</string>
    <string name="dejavu_sync_found_no_zen">Nisciun dæto de Zen trovou</string>
    <string name="dejavu_sync_found_zen_off">Zen trovou, ma a sò sincronizzaçion de a barra laterale a l\'è dexativâ</string>

    <string name="dejavu_sync_firefox_summary">Firefox-იან თითოეულ კომპიუტერსა და ტელეფონს საკუთარი სივრცე ეძლევა: მიმაგრებული ჩანართები მიმაგრებული რჩება, ჩანართების ჯგუფები თავიანთი ფერის საქაღალდეებად იქცევა, ხოლო მისი სხვა ჩანართები იქ იხსნება. ამ სივრცეებში შეგიძლიათ ჩანართების გახსნა და დახურვა, მოწყობილობა კი იგივეს აკეთებს.</string>
    <string name="dejavu_sync_zen_summary">სივრცეები, მიმაგრებული ჩანართები, საჭირო საიტები და საქაღალდეები ერთნაირი რჩება Zen-სა და Dejavu-ში, ორივე მიმართულებით.</string>
    <string name="dejavu_sync_switch_from_zen">Zen-ის სივრცეები Dejavu-ში რჩება, მაგრამ აღარ სინქრონდება.</string>
    <string name="dejavu_sync_switch_from_firefox">თქვენი Firefox-იანი მოწყობილობების სივრცეები Dejavu-დან წაიშლება. Firefox მათ ჩანართებს შეინარჩუნებს.</string>
    <string name="dejavu_sync_problem_choose">სინქრონიზაცია შეჩერებულია, სანამ Firefox-ს ან Zen-ს აირჩევთ.</string>
    <string name="dejavu_sync_problem_tabs_off">გახსნილი ჩანართების სინქრონიზაცია გამორთულია თქვენი Mozilla-ანგარიშისთვის. ჩართეთ „გახსნილი ჩანართები“ თქვენი ანგარიშის სინქრონიზაციის პარამეტრებში, აქ ან Firefox-ში.</string>
    <string name="dejavu_sync_problem_no_firefox">ჯერჯერობით არცერთი სხვა მოწყობილობის Firefox არ ასინქრონებს თავის გახსნილ ჩანართებს თქვენს ანგარიშთან.</string>

<!-- Dejavu's logo with its name beside it, where Firefox showed its logo and wordmark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="40dp"
        android:height="40dp"
        android:gravity="left|center_vertical"
        android:drawable="@drawable/dejavu_logo" />
    <!-- Moved down a little, so the letters, not the "j" below them, are level with the logo's middle. -->
    <item
        android:left="52dp"
        android:top="4dp"
        android:width="92.1dp"
        android:height="28dp"
        android:gravity="left|center_vertical"
        android:drawable="@drawable/dejavu_wordmark" />
</layer-list>

<!-- Dejavu's text field for the screens made of views, like DejavuTextField: a rounded well with a hairline edge
   - that turns gold while typing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/colorSurfaceContainerLowest" />
            <stroke android:width="1.5dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/colorSurfaceContainerLowest" />
            <stroke android:width="1dp" android:color="@color/dejavu_popup_edge" />
        </shape>
    </item>
</selector>

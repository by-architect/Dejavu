    <string name="dejavu_sync_choose_title">Nima bilan sinxronlashtirishni tanlang</string>
    <string name="dejavu_sync_choose_intro">Dejavu Mozilla hisobingiz nimalarni sinxronlashtirishini tekshirdi. Ish maydonlaringiz ergashadigan brauzerni tanlang. Siz tanlamaguningizcha ish maydonlari sinxronlashtirilmaydi.</string>

    <string name="dejavu_onboarding_notifications_title">Bildirishnomalar sizni doim xabardor qilib turadi</string>
    <string name="dejavu_onboarding_notifications_subtitle">Yuklanmalar qachon tugashini ko\'ring, Dejavu-ni ochmasdan musiqa va videolarni ijro eting yoki pauza qiling.</string>

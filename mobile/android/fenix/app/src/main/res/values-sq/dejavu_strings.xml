    <string name="dejavu_sync_problem_offline">S\'u arrit të kontaktohen shërbyesit e njëkohësimit. Dejavu do ta riprovojë.</string>
    <string name="dejavu_sync_problem_server">Shërbyesit e njëkohësimit patën një problem. Dejavu do ta riprovojë.</string>

    <!-- Settings -->
    <string name="dejavu_settings_title">Dejavu</string>
    <string name="dejavu_about_content">%1$s হলো Mozilla-র ওপেন সোর্স Firefox ও GeckoView কোড থেকে তৈরি একটি স্বাধীন ব্রাউজার। এটি Mozilla-র তৈরি নয়, এবং Mozilla এটিকে অনুমোদন বা সমর্থন করে না। Firefox হলো মার্কিন যুক্তরাষ্ট্র ও অন্যান্য দেশে Mozilla Foundation-এর ট্রেডমার্ক।</string>
    <string name="dejavu_about_source_code">সোর্স কোড</string>
    <string name="dejavu_settings_tab_actions">ট্যাব অ্যাকশন</string>
    <string name="dejavu_settings_tab_actions_entry_summary">অ্যাকশনের একটি তালিকা, আর প্রতিটি কোথায় দেখায়</string>
    <string name="dejavu_settings_tab_actions_hint">আপনার নিজের যোগ করা অ্যাকশনসহ সব অ্যাকশন একটি তালিকায় আছে। প্রতিটি কোথায় দেখাবে তা বেছে নিন: পিন করা ট্যাব, পিন না করা ট্যাব ও ফোল্ডারে, নির্বাচিত ট্যাবের বারে, আরও অপশন মেনুতে এবং পাতার নিচের অ্যাকশন বারে। কোনো ফোল্ডারের অ্যাকশন তার ভেতরের প্রতিটি ট্যাবে প্রযোজ্য হয়।</string>
    <string name="dejavu_settings_where_actions_show">অ্যাকশন কোথায় দেখায়</string>

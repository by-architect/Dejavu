    <string name="dejavu_sync_start_merge_firefox">שומרים עליהם, לצד מרחב עבודה לכל מחשב וטלפון עם Firefox.</string>
    <string name="dejavu_sync_start_fresh">התחלה מחדש</string>
    <string name="dejavu_sync_start_fresh_zen">סוגרים את הלשוניות האלה ומסירים את מרחבי העבודה, הלשוניות המוצמדות, התיקיות והמועדפים האלה, ואז מביאים את מרחבי העבודה שלכם מ-Zen.</string>
    <string name="dejavu_sync_start_fresh_firefox">סוגרים את הלשוניות האלה ומסירים את מרחבי העבודה, הלשוניות המוצמדות, התיקיות והמועדפים האלה, ואז מציגים את הלשוניות של המחשבים והטלפונים שלכם עם Firefox.</string>
    <string name="dejavu_private_link_copied">הקישור של הלשונית הפרטית הועתק. הוא יישאר בלוח הגזירים עד שיועתק משהו אחר.</string>
    <string name="dejavu_open_non_web_pin_title">לפתוח את הכתובת הזאת?</string>
    <string name="dejavu_open_non_web_pin_message">לשונית מוצמדת זו פותחת כתובת שאינה דף אינטרנט. ייתכן שהיא הגיעה ממכשיר אחר בחשבון שלך.\n\n%1$s</string>
    <string name="dejavu_open">פתיחה</string>
    <string name="dejavu_about_config_warning_title">לפתוח את about:config?</string>
    <string name="dejavu_about_config_warning_message">שינוי הגדרות אלה עלול להחליש את האבטחה והפרטיות של Dejavu, או לשבש אתרים. שינוי של הגדרה שעליה מבוססת ההגנה מפני מעקב של Dejavu גורם לכך שהיא מנוהלת כאן עד לאיפוס שלה. הגדרות אחרות שההגדרות של Dejavu שולטות בהן חוזרות אליהן כש-Dejavu מופעל מחדש.</string>
    <string name="dejavu_remote_debugging_warning_title">להפעיל ניפוי שגיאות מרחוק?</string>
    <string name="dejavu_remote_debugging_warning_message">כל עוד הוא פעיל, מחשב שמחובר לטלפון הזה ב-USB, עם הרשאה לניפוי שגיאות ב-USB, יכול לשלוט ב-Dejavu ולקרוא את הנתונים שלו, כמו לשוניות פתוחות, עוגיות וססמאות שמורות, בלי לשאול. יש לכבות אותו בסיום.</string>
    <string name="dejavu_turn_on">הפעלה</string>
    <string name="dejavu_settings_safe_browsing_no_key">לגרסה זו של Dejavu אין מפתח Safe Browsing, ולכן היא לא יכולה להזהיר מפני אתרים מסוכנים.</string>
    <string name="dejavu_custom_action_http_warning">הכתובת הזאת משתמשת ב-http, ולכן הבקשה, הכותרות שלה וכתובת הדף עוברות ללא הצפנה. יש להשתמש ב-https אם השרת תומך בו.</string>
    <string name="dejavu_example_notification_ntfy">שליחת הדף כהתראה. כל מי שיודע את שם הנושא יכול לקרוא אותה, לכן כדאי לבחור שם ארוך ואקראי.</string>
    <string name="dejavu_direct_calls_warning_title">לאפשר חיבורים ישירים?</string>
    <string name="dejavu_direct_calls_warning_message">האנשים שאליהם מתקשרים והאתרים שמבצעים שיחות יוכלו אז לראות את כתובת ה־IP שלך. אתרים שמורשים להשתמש במצלמה או במיקרופון שלך יוכלו לראות גם את הכתובות שלך ברשת המקומית.</string>
    <string name="dejavu_network_location_warning_title">להשתמש במיקום מהרשת?</string>
    <string name="dejavu_network_location_warning_message">בטלפונים עם Google Play Services, מערכת Android מאתרת את המיקום שלך על ידי שליחת רשתות ה־Wi-Fi והאנטנות הסלולריות שבסביבתך ל־Google. אתרים עדיין מקבלים את המיקום שלך רק אחרי שנתת להם הרשאה.</string>
    <string name="dejavu_protection_safe_browsing_on">Dejavu מזהיר אותך לפני אתרים שמפיצים תוכנות זדוניות או גונבים ססמאות. כדי לבדוק אותם, הוא שולח ל־Google קטעים קצרים ומעורבלים של חלק מהכתובות.</string>

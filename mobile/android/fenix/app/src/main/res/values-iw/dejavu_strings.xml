    <string name="dejavu_sync_firefox_summary">כל מחשב וטלפון עם Firefox מקבל מרחב עבודה משלו: לשוניות מוצמדות נשארות מוצמדות, קבוצות לשוניות הופכות לתיקיות בצבעים שלהן, ושאר הלשוניות שלו נפתחות שם. במרחבי העבודה האלה אפשר לפתוח ולסגור לשוניות, והמכשיר עושה את אותו הדבר.</string>
    <string name="dejavu_sync_zen_summary">מרחבי עבודה, לשוניות מוצמדות, מועדפים ותיקיות נשארים זהים ב-Zen וב-Dejavu, בשני הכיוונים.</string>
    <string name="dejavu_sync_switch_from_zen">מרחבי העבודה מ-Zen נשארים ב-Dejavu, אבל כבר לא מסתנכרנים.</string>
    <string name="dejavu_sync_switch_from_firefox">מרחבי העבודה של המכשירים שלכם עם Firefox מוסרים מ-Dejavu. Firefox שומר את הלשוניות שלהם.</string>
    <string name="dejavu_sync_problem_choose">הסנכרון מושהה עד שתבחרו ב-Firefox או ב-Zen.</string>
    <string name="dejavu_sync_problem_tabs_off">סנכרון הלשוניות הפתוחות כבוי עבור חשבון Mozilla שלכם. הפעילו את “לשוניות פתוחות” בהגדרות הסנכרון של החשבון שלכם, כאן או ב-Firefox.</string>
    <string name="dejavu_sync_problem_no_firefox">עדיין אין Firefox במכשיר אחר שמסנכרן את הלשוניות הפתוחות שלו לחשבון שלכם.</string>
